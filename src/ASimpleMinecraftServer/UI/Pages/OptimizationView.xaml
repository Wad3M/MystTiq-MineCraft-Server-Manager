<UserControl x:Class="ASimpleMinecraftServer.UI.Pages.OptimizationView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Border Style="{StaticResource Card}" Padding="18" Margin="0,0,0,12"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="OPTIMIZATION RECOMMENDATIONS" Style="{StaticResource SectionHeader}"/><TextBlock x:Name="SummaryText" Text="Generate conservative recommendations from the server profile and properties." Foreground="{StaticResource TextSecondary}"/></StackPanel><Button x:Name="GenerateButton" Grid.Column="1" Content="Generate" Style="{StaticResource PrimaryButton}" Padding="16,8" Click="Generate_Click"/></Grid></Border><Border Grid.Row="1" Style="{StaticResource Card}" Padding="10"><DataGrid x:Name="ItemsGrid" AutoGenerateColumns="False" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="Priority" Binding="{Binding Priority}" Width="90"/><DataGridTextColumn Header="Area" Binding="{Binding Area}" Width="130"/><DataGridTextColumn Header="Recommendation" Binding="{Binding Recommendation}" Width="2*"/><DataGridTextColumn Header="Why" Binding="{Binding Reason}" Width="2*"/></DataGrid.Columns></DataGrid></Border></Grid></UserControl>