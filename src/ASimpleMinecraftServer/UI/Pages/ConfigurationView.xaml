<UserControl x:Class="ASimpleMinecraftServer.UI.Pages.ConfigurationView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
<Border Style="{StaticResource Card}" Padding="18">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="SERVER CONFIGURATION" Style="{StaticResource SectionHeader}"/>
                                    <TextBlock x:Name="ConfigurationServerText" Text="Select a server to edit its server.properties file." Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button x:Name="SimpleConfigButton" Style="{StaticResource GreenActionButton}" Content="Simple" Width="100" Click="SimpleConfig_Click"/>
                                    <Button x:Name="AdvancedConfigButton" Style="{StaticResource SecondaryButton}" Content="Advanced" Width="110" Click="AdvancedConfig_Click"/>
                                </StackPanel>
                            </Grid>
                            <Border Grid.Row="1" Height="1" Background="#E6E9EB" Margin="0,14,0,14"/>
                            <Grid Grid.Row="2">
                                <ScrollViewer x:Name="SimpleConfigPanel" VerticalScrollBarVisibility="Auto">
                                    <StackPanel>
                                        <TextBlock Text="Common settings" FontSize="20" FontWeight="Bold" Margin="0,0,0,4"/>
                                        <TextBlock Text="Frequently changed options, grouped for easier setup." Foreground="{StaticResource TextSecondary}" Margin="0,0,0,16"/>
                                        <TextBlock Text="SERVER" Style="{StaticResource SectionHeader}"/>
                                        <Grid Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                            <StackPanel Margin="0,0,8,10"><TextBlock Text="Message of the day" FontWeight="Bold"/><TextBox x:Name="ConfigMotdBox"/></StackPanel>
                                            <StackPanel Grid.Column="1" Margin="8,0,0,10"><TextBlock Text="Maximum players" FontWeight="Bold"/><TextBox x:Name="ConfigMaxPlayersBox"/></StackPanel>
                                            <StackPanel Grid.Row="1" Margin="0,0,8,0"><TextBlock Text="Server port" FontWeight="Bold"/><TextBox x:Name="ConfigPortBox"/></StackPanel>
                                            <StackPanel Grid.Row="1" Grid.Column="1" Margin="8,0,0,0"><TextBlock Text="Game mode" FontWeight="Bold"/><ComboBox x:Name="ConfigGameModeCombo"><ComboBoxItem Content="survival"/><ComboBoxItem Content="creative"/><ComboBoxItem Content="adventure"/><ComboBoxItem Content="spectator"/></ComboBox></StackPanel>
                                        </Grid>
                                        <TextBlock Text="GAMEPLAY" Style="{StaticResource SectionHeader}"/>
                                        <Grid Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                            <StackPanel Margin="0,0,8,10"><TextBlock Text="Difficulty" FontWeight="Bold"/><ComboBox x:Name="ConfigDifficultyCombo"><ComboBoxItem Content="peaceful"/><ComboBoxItem Content="easy"/><ComboBoxItem Content="normal"/><ComboBoxItem Content="hard"/></ComboBox></StackPanel>
                                            <CheckBox x:Name="ConfigPvpCheckBox" Grid.Column="1" Content="Enable PvP" FontWeight="Bold" VerticalAlignment="Center" Margin="8,16,0,10"/>
                                            <CheckBox x:Name="ConfigOnlineModeCheckBox" Grid.Row="1" Content="Online mode" FontWeight="Bold" Margin="0,8,8,10"/>
                                            <CheckBox x:Name="ConfigHardcoreCheckBox" Grid.Row="1" Grid.Column="1" Content="Hardcore" FontWeight="Bold" Margin="8,8,0,10"/>
                                            <CheckBox x:Name="ConfigAllowFlightCheckBox" Grid.Row="2" Content="Allow flight" FontWeight="Bold" Margin="0,8,8,0"/>
                                            <CheckBox x:Name="ConfigAllowNetherCheckBox" Grid.Row="2" Grid.Column="1" Content="Allow Nether" FontWeight="Bold" Margin="8,8,0,0"/>
                                        </Grid>
                                        <TextBlock Text="WORLD &amp; PERFORMANCE" Style="{StaticResource SectionHeader}"/>
                                        <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                            <StackPanel Margin="0,0,8,10"><TextBlock Text="Level seed" FontWeight="Bold"/><TextBox x:Name="ConfigSeedBox"/></StackPanel>
                                            <StackPanel Grid.Column="1" Margin="8,0,0,10"><TextBlock Text="Spawn protection" FontWeight="Bold"/><TextBox x:Name="ConfigSpawnProtectionBox"/></StackPanel>
                                            <StackPanel Grid.Row="1" Margin="0,0,8,10"><TextBlock Text="View distance" FontWeight="Bold"/><TextBox x:Name="ConfigViewDistanceBox"/></StackPanel>
                                            <StackPanel Grid.Row="1" Grid.Column="1" Margin="8,0,0,10"><TextBlock Text="Simulation distance" FontWeight="Bold"/><TextBox x:Name="ConfigSimulationDistanceBox"/></StackPanel>
                                            <CheckBox x:Name="ConfigSpawnAnimalsCheckBox" Grid.Row="2" Content="Spawn animals" FontWeight="Bold" Margin="0,8,8,0"/>
                                            <CheckBox x:Name="ConfigSpawnMonstersCheckBox" Grid.Row="2" Grid.Column="1" Content="Spawn monsters" FontWeight="Bold" Margin="8,8,0,0"/>
                                        </Grid>
                                    </StackPanel>
                                </ScrollViewer>
                                <Grid x:Name="AdvancedConfigPanel" Visibility="Collapsed">
                                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                    <TextBox x:Name="ConfigurationSearchBox" ToolTip="Search option or value" TextChanged="ConfigurationSearchBox_TextChanged" Margin="0,0,0,10"/>
                                    <DataGrid x:Name="AdvancedPropertiesGrid" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column" IsReadOnly="False" SelectionMode="Single">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Option" Binding="{Binding Key}" IsReadOnly="True" Width="2*"/>
                                            <DataGridTextColumn Header="Value" Binding="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Width="3*"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Grid>
                            </Grid>
                            <Grid Grid.Row="3" Margin="0,16,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock x:Name="ConfigurationStatusText" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Content="Reload" Width="100" Click="ReloadConfiguration_Click"/>
                                <Button Grid.Column="2" Style="{StaticResource GreenActionButton}" Content="Save Changes" Width="140" Margin="8,0,0,0" Click="SaveConfiguration_Click"/>
                            </Grid>
                        </Grid>
                    </Border>
</UserControl>
