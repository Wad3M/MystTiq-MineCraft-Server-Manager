<UserControl x:Class="ASimpleMinecraftServer.UI.Pages.HealthAnalyzerView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <Border Style="{StaticResource Card}" Margin="0,0,0,12"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="SERVER HEALTH ANALYZER" Style="{StaticResource SectionHeader}"/><TextBlock x:Name="ServerText" Text="Select a server and run an analysis." Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap"/></StackPanel><Button Grid.Column="1" x:Name="AnalyzeButton" Style="{StaticResource PrimaryButton}" Content="Analyze Server" Click="Analyze_Click" Margin="12,0,0,0"/></Grid></Border>
  <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,12"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition/></Grid.ColumnDefinitions><Border Width="96" Height="96" CornerRadius="48" Background="#E8F5E3" BorderBrush="#69B952" BorderThickness="3"><StackPanel VerticalAlignment="Center"><TextBlock x:Name="ScoreText" Text="—" FontSize="30" FontWeight="Bold" Foreground="#226B25" HorizontalAlignment="Center"/><TextBlock Text="HEALTH" FontSize="10" FontWeight="Bold" Foreground="#4A7550" HorizontalAlignment="Center"/></StackPanel></Border><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock x:Name="GradeText" Text="Not analyzed" FontSize="25" FontWeight="Bold" Foreground="#173D2A"/><TextBlock x:Name="SummaryText" Text="The analyzer checks installation files, Java, memory, configuration, backups, and plugins." Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" Margin="0,6,0,0"/><ProgressBar x:Name="ScoreBar" Maximum="100" Value="0" Height="9" Margin="0,12,0,0" Foreground="#3F9E2F"/></StackPanel></Grid></Border>
  <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0"><DataGrid x:Name="ChecksGrid" AutoGenerateColumns="False" IsReadOnly="True" GridLinesVisibility="Horizontal" BorderThickness="0"><DataGrid.Columns><DataGridTextColumn Header="CATEGORY" Binding="{Binding Category}" Width="110"/><DataGridTextColumn Header="CHECK" Binding="{Binding Check}" Width="150"/><DataGridTextColumn Header="STATUS" Binding="{Binding Status}" Width="120"/><DataGridTextColumn Header="DETAILS" Binding="{Binding Details}" Width="2*"/></DataGrid.Columns></DataGrid></Border>
 </Grid>
</UserControl>
