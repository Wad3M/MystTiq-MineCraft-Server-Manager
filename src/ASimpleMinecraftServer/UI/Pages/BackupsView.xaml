<UserControl x:Class="ASimpleMinecraftServer.UI.Pages.BackupsView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
<Border Style="{StaticResource Card}" Padding="18">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel><TextBlock Text="SERVER BACKUPS" Style="{StaticResource SectionHeader}"/><TextBlock x:Name="BackupServerTextControl" Text="Select a server to manage its backups." Foreground="{StaticResource TextSecondary}"/></StackPanel>
                                <Button Grid.Column="1" Style="{StaticResource GreenActionButton}" Content="Create Backup" Width="145" Click="CreateBackup_Click"/>
                            </Grid>
                            <Border Grid.Row="1" Height="1" Background="#E6E9EB" Margin="0,14,0,14"/>
                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <DataGrid x:Name="BackupsGridControl" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" SelectionMode="Single" HeadersVisibility="Column">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Created" Binding="{Binding CreatedText}" Width="1.4*"/>
                                        <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="*"/>
                                        <DataGridTextColumn Header="Size" Binding="{Binding SizeText}" Width="*"/>
                                        <DataGridTextColumn Header="Archive" Binding="{Binding Name}" Width="2*"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                                <StackPanel Grid.Column="2">
                                    <Border Background="#F7F9FA" BorderBrush="#D9DEE2" BorderThickness="1" CornerRadius="10" Padding="14">
                                        <StackPanel>
                                            <TextBlock Text="AUTOMATIC BACKUPS" Style="{StaticResource SectionHeader}"/>
                                            <CheckBox x:Name="AutomaticBackupsCheckBoxControl" Content="Enable scheduled backups" FontWeight="Bold" Checked="BackupSettings_Changed" Unchecked="BackupSettings_Changed"/>
                                            <TextBlock Text="Interval" Style="{StaticResource FieldCaption}" Margin="0,14,0,4"/>
                                            <ComboBox x:Name="BackupIntervalComboControl" SelectionChanged="BackupSettings_Changed"><ComboBoxItem Content="30 minutes" Tag="30"/><ComboBoxItem Content="1 hour" Tag="60"/><ComboBoxItem Content="3 hours" Tag="180"/><ComboBoxItem Content="6 hours" Tag="360"/><ComboBoxItem Content="12 hours" Tag="720"/><ComboBoxItem Content="24 hours" Tag="1440"/></ComboBox>
                                            <TextBlock Text="Keep newest" Style="{StaticResource FieldCaption}" Margin="0,14,0,4"/>
                                            <ComboBox x:Name="BackupRetentionComboControl" SelectionChanged="BackupSettings_Changed"><ComboBoxItem Content="5 backups" Tag="5"/><ComboBoxItem Content="10 backups" Tag="10"/><ComboBoxItem Content="20 backups" Tag="20"/><ComboBoxItem Content="50 backups" Tag="50"/></ComboBox>
                                            <TextBlock x:Name="LastAutomaticBackupTextControl" Text="Last automatic backup: —" Foreground="{StaticResource TextSecondary}" Margin="0,14,0,0"/>
                                            <TextBlock x:Name="NextAutomaticBackupTextControl" Text="Next automatic backup: —" Foreground="{StaticResource TextSecondary}" Margin="0,4,0,0"/>
                                            <TextBlock Text="Schedules are evaluated for every saved profile while the manager is open. Stopped servers can be backed up safely; running servers are flushed first when console control is available." Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" Margin="0,12,0,0"/>
                                        </StackPanel>
                                    </Border>
                                    <Button Style="{StaticResource SecondaryButton}" Content="Open Backup Folder" Margin="0,12,0,0" Click="OpenBackupFolder_Click"/>
                                </StackPanel>
                            </Grid>
                            <Grid Grid.Row="3" Margin="0,16,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel><TextBlock x:Name="BackupStatusTextControl" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap"/><ProgressBar x:Name="BackupProgressBarControl" Height="5" IsIndeterminate="True" Visibility="Collapsed" Margin="0,6,20,0"/></StackPanel>
                                <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Content="Refresh" Width="95" Click="RefreshBackups_Click"/>
                                <Button Grid.Column="2" Style="{StaticResource WarningButton}" Content="Restore Selected" Width="145" Margin="8,0,0,0" Click="RestoreBackup_Click"/>
                                <Button Grid.Column="3" Style="{StaticResource DangerButton}" Content="Delete Selected" Width="140" Margin="8,0,0,0" Click="DeleteBackup_Click"/>
                            </Grid>
                        </Grid>
                    </Border>
</UserControl>
