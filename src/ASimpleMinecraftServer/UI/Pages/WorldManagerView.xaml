<UserControl x:Class="ASimpleMinecraftServer.UI.Pages.WorldManagerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
<Border Style="{StaticResource Card}" Padding="18">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel><TextBlock Text="WORLD MANAGER" Style="{StaticResource SectionHeader}"/><TextBlock x:Name="WorldServerTextControl" x:FieldModifier="public" Text="Select a server to inspect its worlds." Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap"/></StackPanel>
            <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Content="Import World ZIP" Width="145" Margin="8,0,0,0" Click="ImportWorld_Click"/>
            <Button Grid.Column="2" Style="{StaticResource BlueActionButton}" Content="Refresh Worlds" Width="130" Margin="8,0,0,0" Click="RefreshWorlds_Click"/>
        </Grid>
        <Border Grid.Row="1" Height="1" Background="#E6E9EB" Margin="0,14,0,14"/>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="2.2*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <DataGrid x:Name="WorldsGridControl" x:FieldModifier="public" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" SelectionMode="Single" HeadersVisibility="Column" SelectionChanged="WorldsGrid_SelectionChanged">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="World" Binding="{Binding Name}" Width="1.4*"/>
                    <DataGridTextColumn Header="Dimension" Binding="{Binding Dimension}" Width="*"/>
                    <DataGridTextColumn Header="Size" Binding="{Binding SizeText}" Width="*"/>
                    <DataGridTextColumn Header="Last Modified" Binding="{Binding LastModifiedText}" Width="1.25*"/>
                    <DataGridTextColumn Header="Health" Binding="{Binding Health}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
            <StackPanel Grid.Column="2">
                <Border Background="#F7F9FA" BorderBrush="#D9DEE2" BorderThickness="1" CornerRadius="10" Padding="14">
                    <StackPanel>
                        <TextBlock Text="WORLD DETAILS" Style="{StaticResource SectionHeader}"/>
                        <TextBlock Text="NAME" Style="{StaticResource FieldCaption}"/><TextBlock x:Name="WorldDetailNameTextControl" x:FieldModifier="public" Text="—" FontWeight="Bold" Margin="0,2,0,10" TextWrapping="Wrap"/>
                        <TextBlock Text="DIMENSION" Style="{StaticResource FieldCaption}"/><TextBlock x:Name="WorldDetailDimensionTextControl" x:FieldModifier="public" Text="—" Margin="0,2,0,10"/>
                        <TextBlock Text="FOLDER" Style="{StaticResource FieldCaption}"/><TextBlock x:Name="WorldDetailFolderTextControl" x:FieldModifier="public" Text="—" Margin="0,2,0,10" TextWrapping="Wrap" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                        <TextBlock Text="SIZE / LAST MODIFIED" Style="{StaticResource FieldCaption}"/><TextBlock x:Name="WorldDetailStatsTextControl" x:FieldModifier="public" Text="—" Margin="0,2,0,10" TextWrapping="Wrap"/>
                        <TextBlock Text="INTEGRITY" Style="{StaticResource FieldCaption}"/><TextBlock x:Name="WorldDetailHealthTextControl" x:FieldModifier="public" Text="—" Margin="0,2,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
                <TextBlock Text="Stop the selected server before importing, renaming, or deleting worlds. World backups can be created while stopped for the safest result." Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" Margin="2,12,2,0"/>
            </StackPanel>
        </Grid>
        <Grid Grid.Row="3" Margin="0,16,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel><TextBlock x:Name="WorldStatusTextControl" x:FieldModifier="public" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap"/><ProgressBar x:Name="WorldProgressBarControl" x:FieldModifier="public" Height="5" Minimum="0" Maximum="100" Visibility="Collapsed" Margin="0,6,20,0"/></StackPanel>
            <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Content="Open Folder" Width="110" Click="OpenWorldFolder_Click"/>
            <Button Grid.Column="2" Style="{StaticResource BlueActionButton}" Content="Verify" Width="90" Margin="8,0,0,0" Click="VerifyWorld_Click"/>
            <Button Grid.Column="3" Style="{StaticResource SuccessButton}" Content="Backup World" Width="120" Margin="8,0,0,0" Click="BackupWorld_Click"/>
            <Button Grid.Column="4" Style="{StaticResource WarningButton}" Content="Rename" Width="95" Margin="8,0,0,0" Click="RenameWorld_Click"/>
            <Button Grid.Column="5" Style="{StaticResource DangerButton}" Content="Delete" Width="95" Margin="8,0,0,0" Click="DeleteWorld_Click"/>
        </Grid>
    </Grid>
</Border>
</UserControl>
