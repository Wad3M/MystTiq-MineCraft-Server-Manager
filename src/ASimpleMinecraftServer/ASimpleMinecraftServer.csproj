<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <AssemblyName>ASimpleMinecraftServer</AssemblyName>
    <RootNamespace>ASimpleMinecraftServer</RootNamespace>
    <Version>0.2.0</Version>
    <FileVersion>0.2.0.0</FileVersion>
    <AssemblyVersion>0.2.0.0</AssemblyVersion>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Assets\app.ico" />
    <Resource Include="Assets\brand.png" />
    <Resource Include="Assets\dashboard-landscape.png" />
    <Resource Include="Assets\sidebar-hero.png" />
    <Resource Include="Assets\Icons\*.png" />
  </ItemGroup>
  <ItemGroup>
    <!-- v2.1.3: the legacy MainWindow is retained in source history only.
         It is excluded from compilation so the polished shell owns the app natively. -->
    <Compile Remove="MainWindow.xaml.cs" />
    <Compile Remove="MainWindow.ExternalHost.cs" />
    <Page Remove="MainWindow.xaml" />
  </ItemGroup>
</Project>
