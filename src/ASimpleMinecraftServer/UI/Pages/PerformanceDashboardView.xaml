<UserControl x:Class="ASimpleMinecraftServer.UI.Pages.PerformanceDashboardView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Border Style="{StaticResource Card}" Padding="18" Margin="0,0,0,12"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="PERFORMANCE DASHBOARD" Style="{StaticResource SectionHeader}"/><TextBlock x:Name="SummaryText" Text="Review a live Java process snapshot and server performance settings." Foreground="{StaticResource TextSecondary}"/></StackPanel><Button x:Name="RefreshButton" Grid.Column="1" Content="Refresh Snapshot" Style="{StaticResource PrimaryButton}" Padding="16,8" Click="Refresh_Click"/></Grid></Border><UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,12"><Border Style="{StaticResource Card}" Margin="0,0,8,0"><StackPanel><TextBlock Text="JAVA MEMORY" Style="{StaticResource SectionHeader}"/><TextBlock x:Name="MemoryText" Text="—" FontSize="22" FontWeight="Bold"/></StackPanel></Border><Border Style="{StaticResource Card}" Margin="0,0,8,0"><StackPanel><TextBlock Text="CPU TIME" Style="{StaticResource SectionHeader}"/><TextBlock x:Name="CpuText" Text="—" FontSize="22" FontWeight="Bold"/></StackPanel></Border><Border Style="{StaticResource Card}" Margin="0,0,8,0"><StackPanel><TextBlock Text="THREADS" Style="{StaticResource SectionHeader}"/><TextBlock x:Name="ThreadsText" Text="—" FontSize="22" FontWeight="Bold"/></StackPanel></Border><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="PLUGINS" Style="{StaticResource SectionHeader}"/><TextBlock x:Name="PluginsText" Text="—" FontSize="22" FontWeight="Bold"/></StackPanel></Border></UniformGrid><Border Grid.Row="2" Style="{StaticResource Card}" Padding="18"><StackPanel><TextBlock Text="SERVER LOAD SETTINGS" Style="{StaticResource SectionHeader}"/><TextBlock x:Name="SettingsText" Text="Select a server." TextWrapping="Wrap" LineHeight="24"/><TextBlock x:Name="GuidanceText" Margin="0,16,0,0" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap"/></StackPanel></Border></Grid></UserControl>