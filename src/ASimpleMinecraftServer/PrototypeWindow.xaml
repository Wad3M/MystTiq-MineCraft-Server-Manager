<Window x:Class="ASimpleMinecraftServer.PrototypeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MystMC v2.2.0"
        Width="1440" Height="900" MinWidth="1080" MinHeight="700"
        WindowStartupLocation="CenterScreen" WindowState="Maximized"
        Background="{DynamicResource AppBackground}" Foreground="{DynamicResource TextBrush}"
        FontFamily="Segoe UI" UseLayoutRounding="True" SnapsToDevicePixels="True"
        Loaded="Window_Loaded">
    <Grid Margin="10">
        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="36"/></Grid.RowDefinitions>
        <Grid.ColumnDefinitions><ColumnDefinition x:Name="SidebarColumn" Width="225"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

        <Border Grid.Column="0" Style="{StaticResource Card}" Background="{DynamicResource SidebarBrush}" Padding="0" Margin="0,0,8,0">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/></Grid.ColumnDefinitions>
                <DockPanel Grid.Column="0" Margin="6">
                <StackPanel DockPanel.Dock="Top">
                    <Button Style="{StaticResource NavButton}" Click="Nav_Click" Tag="Dashboard" Background="{DynamicResource ButtonHoverBrush}">
                        <StackPanel Orientation="Horizontal"><Image x:Name="DashboardNavIcon" Source="Assets/MockupIcons_36/dashboard.png" Width="36" Height="36" Margin="0,0,8,0" RenderOptions.BitmapScalingMode="NearestNeighbor"/><TextBlock x:Name="DashboardNavText" Text="Dashboard" VerticalAlignment="Center" FontWeight="SemiBold"/></StackPanel>
                    </Button>
                    <Button Style="{StaticResource NavButton}" Click="Nav_Click" Tag="Create Server"><StackPanel Orientation="Horizontal"><Image x:Name="CreateNavIcon" Source="Assets/MockupIcons_36/create.png" Width="36" Height="36" Margin="0,0,8,0" RenderOptions.BitmapScalingMode="NearestNeighbor"/><TextBlock x:Name="CreateNavText" Text="Create Server" VerticalAlignment="Center"/></StackPanel></Button>
                    <Button Style="{StaticResource NavButton}" Click="Nav_Click" Tag="Console"><StackPanel Orientation="Horizontal"><Image x:Name="ConsoleNavIcon" Source="Assets/MockupIcons_36/console.png" Width="36" Height="36" Margin="0,0,8,0" RenderOptions.BitmapScalingMode="NearestNeighbor"/><TextBlock x:Name="ConsoleNavText" Text="Console" VerticalAlignment="Center"/></StackPanel></Button>
                </StackPanel>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="NavHost" Margin="0,5,0,0"/>
                </ScrollViewer>
                </DockPanel>
                <Button x:Name="SidebarToggleButton" Grid.Column="1" Style="{StaticResource SidebarToggleButton}" Click="ToggleSidebar_Click" ToolTip="Collapse or expand the sidebar" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                    <Path x:Name="SidebarToggleArrow" Width="10" Height="18" Stretch="Fill" Fill="{DynamicResource TextBrush}" Data="M10,0 L0,9 L10,18 Z"/>
                </Button>
            </Grid>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions><RowDefinition Height="58"/><RowDefinition Height="48"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="235"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" x:Name="ToolbarHost"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0">
                    <TextBlock Text="Theme" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{DynamicResource MutedTextBrush}"/>
                    <ComboBox x:Name="ThemePicker" Width="130" SelectionChanged="ThemePicker_SelectionChanged">
                        <ComboBoxItem Content="Dark" Tag="ModernDark"/>
                        <ComboBoxItem Content="Light" Tag="Light"/>
                        <ComboBoxItem Content="Minecraft Green" Tag="Minecraft" IsSelected="True"/>
                        <ComboBoxItem Content="Underworld" Tag="Underworld"/>
                        <ComboBoxItem Content="Ender" Tag="Ender"/>
                        <ComboBoxItem Content="Aether (Angelic)" Tag="Aether"/>
                    </ComboBox>
                    <Button Style="{StaticResource SmallButton}" Margin="7,0,0,0" Click="Preview_Click"><TextBlock Text="UI Preview"/></Button>
                </StackPanel>
                <Border Grid.Column="2" Style="{StaticResource Card}" Padding="10,6" Margin="6,0,0,0">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="32"/></Grid.ColumnDefinitions>
                        <StackPanel><TextBlock Text="SERVER STATUS" FontSize="8" FontWeight="SemiBold"/><TextBlock x:Name="ServerStatusText" Text="Ready" Foreground="{DynamicResource AccentBrightBrush}" FontWeight="SemiBold"/><TextBlock x:Name="ServerDetailText" Text="Functional backend connected" FontSize="8" Foreground="{DynamicResource MutedTextBrush}"/></StackPanel>
                        <Image Grid.Column="1" Source="Assets/MockupIcons/signal.png" Width="25" Height="25" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                    </Grid>
                </Border>
            </Grid>

            <Border Grid.Row="1" Style="{StaticResource Card}" Background="{DynamicResource HeaderBrush}" Padding="10,5" Margin="0,0,0,7">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="220"/></Grid.ColumnDefinitions>
                    <TextBlock x:Name="PageIcon" Text="&#xE80F;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="30" Width="34" Height="34" Margin="0,0,9,0" Foreground="{DynamicResource AccentBrightBrush}" TextAlignment="Center" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1"><TextBlock x:Name="PageTitle" Text="Dashboard" FontSize="20" FontWeight="SemiBold"/><TextBlock x:Name="PageSubtitle" Text="Overview of your Minecraft server" FontSize="9" Foreground="{DynamicResource MutedTextBrush}"/></StackPanel>
                    <ComboBox x:Name="ServerPicker" Grid.Column="2" VerticalAlignment="Center" DisplayMemberPath="PickerLabel" SelectionChanged="ServerPicker_SelectionChanged" ToolTip="Select the active Minecraft server"/>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ContentControl x:Name="PageContent"/>
            </ScrollViewer>
        </Grid>

        <Border Grid.Row="1" Grid.ColumnSpan="2" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrushTheme}" BorderThickness="1" CornerRadius="4" Margin="0,7,0,0" Padding="10,0">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                <TextBlock x:Name="ActiveServerFooterText" VerticalAlignment="Center" Text="Active Server: No server selected" Foreground="{DynamicResource AccentBrightBrush}" FontSize="10"/>
                <TextBlock x:Name="ServerVersionFooterText" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center" Text="Server details unavailable" Foreground="{DynamicResource MutedTextBrush}" FontSize="10"/>
                <TextBlock x:Name="PrototypeStatus" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Text="MystMC v2.2.0 — Ready" FontSize="10"/>
            </Grid>
        </Border>
    </Grid>
</Window>
