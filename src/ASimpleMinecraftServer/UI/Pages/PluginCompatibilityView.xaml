<UserControl x:Class="ASimpleMinecraftServer.UI.Pages.PluginCompatibilityView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Border Style="{StaticResource Card}" Padding="18" Margin="0,0,0,12"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="PLUGIN COMPATIBILITY" Style="{StaticResource SectionHeader}"/><TextBlock x:Name="SummaryText" Text="Inspect installed plugin metadata against the selected server." Foreground="{StaticResource TextSecondary}"/></StackPanel><Button x:Name="CheckButton" Grid.Column="1" Content="Check Plugins" Style="{StaticResource PrimaryButton}" Padding="16,8" Click="Check_Click"/></Grid></Border><Border Grid.Row="1" Style="{StaticResource Card}" Padding="10"><DataGrid x:Name="ItemsGrid" AutoGenerateColumns="False" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="Plugin" Binding="{Binding Plugin}" Width="180"/><DataGridTextColumn Header="API version" Binding="{Binding ApiVersion}" Width="100"/><DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="110"/><DataGridTextColumn Header="Details" Binding="{Binding Detail}" Width="*"/></DataGrid.Columns></DataGrid></Border></Grid></UserControl>