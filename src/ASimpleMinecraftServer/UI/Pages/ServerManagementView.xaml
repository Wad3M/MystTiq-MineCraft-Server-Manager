<UserControl x:Class="ASimpleMinecraftServer.UI.Pages.ServerManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
<ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel>
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="SERVER MANAGEMENT" Style="{StaticResource SectionHeader}"/>
                <TextBlock Text="Maintain the selected server profile and installation. Stop a running server before moving, duplicating, or replacing files." Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" Margin="0,0,0,14"/>
                <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="14"/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="PROFILE NAME" Style="{StaticResource FieldCaption}"/>
                        <TextBox x:Name="ManagementNameBoxControl" x:FieldModifier="public" Margin="0,5,0,12"/>
                        <TextBlock Text="SERVER LOCATION" Style="{StaticResource FieldCaption}"/>
                        <TextBox x:Name="ManagementFolderBoxControl" x:FieldModifier="public" IsReadOnly="True" Margin="0,5,0,12"/>
                        <TextBlock Text="JAVA EXECUTABLE" Style="{StaticResource FieldCaption}"/>
                        <Grid Margin="0,5,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="ManagementJavaBoxControl" x:FieldModifier="public"/><Button Grid.Column="1" Content="Browse…" Style="{StaticResource LightButton}" Margin="8,0,0,0" Click="BrowseJava_Click"/></Grid>
                        <WrapPanel Margin="-4,8,-4,0">
                            <Button Content="Auto Detect Java" Style="{StaticResource LightButton}" Margin="4" Click="AutoDetectJava_Click"/>
                            <Button Content="Test Java" Style="{StaticResource SuccessButton}" Margin="4" Click="TestJava_Click"/>
                        </WrapPanel>
                        <TextBlock x:Name="ManagementJavaStatusTextControl" x:FieldModifier="public" Text="Java has not been tested for this server." Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                        <Button Content="Save Profile Changes" Style="{StaticResource PrimaryButton}" Margin="0,12,0,0" Click="SaveManagementProfile_Click"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="SERVER ACTIONS" Style="{StaticResource FieldCaption}"/>
                        <UniformGrid Columns="2" Margin="-4,5,-4,0">
                            <Button Content="Duplicate Server" Style="{StaticResource LightButton}" Margin="4" Click="DuplicateServer_Click"/>
                            <Button Content="Move Server" Style="{StaticResource LightButton}" Margin="4" Click="MoveServer_Click"/>
                            <Button Content="Import Profile" Style="{StaticResource LightButton}" Margin="4" Click="ImportProfile_Click"/>
                            <Button Content="Export Profile" Style="{StaticResource LightButton}" Margin="4" Click="ExportProfile_Click"/>
                            <Button Content="Export Server ZIP" Style="{StaticResource LightButton}" Margin="4" Click="ExportServerZip_Click"/>
                            <Button Content="Verify Installation" Style="{StaticResource SuccessButton}" Margin="4" Click="VerifyServer_Click"/>
                        </UniformGrid>
                        <ProgressBar x:Name="ManagementProgressBarControl" x:FieldModifier="public" Height="8" Minimum="0" Maximum="100" Margin="0,12,0,0"/>
                        <TextBlock x:Name="ManagementStatusTextControl" x:FieldModifier="public" Text="Select a server to begin." Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}" Margin="0,14,0,0">
            <StackPanel>
                <TextBlock Text="SERVER HEALTH" Style="{StaticResource SectionHeader}"/>
                <ItemsControl x:Name="ServerHealthListControl" x:FieldModifier="public">
                    <ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="#DDE2E5" BorderThickness="0,0,0,1" Padding="4,9"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition Width="190"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="{Binding Icon}" FontSize="18"/><TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="Bold"/><TextBlock Grid.Column="2" Text="{Binding Details}" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap"/></Grid></Border></DataTemplate></ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}" Margin="0,14,0,0">
            <StackPanel><TextBlock Text="VERSION MANAGEMENT" Style="{StaticResource SectionHeader}"/><TextBlock Text="Current server type and version are shown below. Automated update downloads and rollback will be introduced after the current installer APIs are unified, preventing unsafe replacement of custom JARs." Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap"/><TextBlock x:Name="ManagementVersionTextControl" x:FieldModifier="public" Text="No server selected" FontWeight="Bold" FontSize="16" Margin="0,12,0,0"/></StackPanel>
        </Border>
    </StackPanel>
</ScrollViewer>
</UserControl>
