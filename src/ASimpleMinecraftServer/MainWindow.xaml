<Window x:Class="ASimpleMinecraftServer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:pages="clr-namespace:ASimpleMinecraftServer.UI.Pages"
        Title="A Simple Minecraft Server"
        Width="1440" Height="900" MinWidth="1120" MinHeight="800"
        WindowStartupLocation="CenterScreen" WindowState="Maximized"
        Background="#F7F9FA" Foreground="#20262D" FontFamily="Segoe UI" PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <Style x:Key="ConsoleOptionCheckBox" TargetType="CheckBox">
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Padding" Value="4,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Background="Transparent" SnapsToDevicePixels="True">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border x:Name="CheckBorder" Width="16" Height="16" CornerRadius="3"
                                    Background="#FFFFFF" BorderBrush="#FFFFFF" BorderThickness="1.5"
                                    HorizontalAlignment="Left" VerticalAlignment="Center">
                                <Path x:Name="CheckMark" Visibility="Collapsed" Data="M 3,8 L 7,12 L 14,4"
                                      Stroke="#238A2A" StrokeThickness="2.2" StrokeStartLineCap="Square" StrokeEndLineCap="Square"/>
                            </Border>
                            <ContentPresenter Grid.Column="1" Margin="7,0,0,0" VerticalAlignment="Center"
                                              RecognizesAccessKey="True" TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckBorder" Property="Background" Value="#FFFFFF"/>
                                <Setter TargetName="CheckBorder" Property="BorderBrush" Value="#FFFFFF"/>
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                <Setter TargetName="CheckBorder" Property="BorderBrush" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Background="#F7F9FA">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="292"/>
            <ColumnDefinition Width="*" MinWidth="400"/>
            <ColumnDefinition Width="*" MinWidth="400"/>
        </Grid.ColumnDefinitions>

        <!-- LEFT BRAND AND NAVIGATION -->
        <Border Grid.Column="0" Background="White" BorderBrush="#E1E5E8" BorderThickness="0,0,1,0">
            <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Grid Height="170" ClipToBounds="True">
                    <Image Source="Assets/sidebar-hero.png" Stretch="UniformToFill" VerticalAlignment="Top" Opacity="0.92"/>
                    <Rectangle VerticalAlignment="Bottom" Height="90"><Rectangle.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#00FFFFFF" Offset="0"/><GradientStop Color="#FFFFFFFF" Offset="1"/></LinearGradientBrush></Rectangle.Fill></Rectangle>
                </Grid>
                <Grid Grid.Row="1" Margin="20,-6,20,14">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="50"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border Width="44" Height="44" CornerRadius="11" Background="#E8F5E3" BorderBrush="#8CCA73" BorderThickness="1" VerticalAlignment="Top">
                        <Image Source="Assets/brand.png" Width="36" Height="36" Stretch="Uniform"/>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="10,-1,0,0">
                        <TextBlock Text="A Simple" Foreground="#2F9A2B" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock Text="Minecraft Server" Foreground="#123A26" FontSize="20" FontWeight="Bold" TextWrapping="Wrap" LineHeight="22"/>
                        <TextBlock x:Name="SidebarVersionText" Text="Version" Foreground="#6F7A81" FontSize="12" Margin="0,4,0,0"/>
                    </StackPanel>
                </Grid>
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="8,0,6,8">
                    <StackPanel Margin="6,0,8,0">
                        <Button x:Name="DashboardNavButton" ToolTip="Dashboard" Style="{StaticResource NavigationButton}" Click="Dashboard_Click"><StackPanel Orientation="Horizontal"><Border Style="{StaticResource NavIconTile}"><Image Source="{StaticResource PixelIconDashboard}" Width="28" Height="28" Stretch="None" SnapsToDevicePixels="True"/></Border><TextBlock Text="Dashboard" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/></StackPanel></Button>
                        <Button x:Name="CreateServerNavButton" ToolTip="Create a new Minecraft server" Style="{StaticResource NavigationButton}" Click="CreateServer_Click"><StackPanel Orientation="Horizontal"><Border Style="{StaticResource NavIconTile}"><Image Source="{StaticResource PixelIconCreate}" Width="28" Height="28" Stretch="None" SnapsToDevicePixels="True"/></Border><TextBlock Text="Create Server" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/></StackPanel></Button>
                        <Button x:Name="ConsoleNavButton" ToolTip="Open the live server console" Style="{StaticResource NavigationButton}" Click="Console_Click"><StackPanel Orientation="Horizontal"><Border Style="{StaticResource NavIconTile}"><Image Source="{StaticResource PixelIconConsole}" Width="28" Height="28" Stretch="None" SnapsToDevicePixels="True"/></Border><TextBlock Text="Console" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/></StackPanel></Button>

                        <Expander Header="SERVER TOOLS" IsExpanded="True" ToolTip="Configuration, backups, plugins, worlds, and server management" Margin="0,4,0,0" FontWeight="SemiBold" Foreground="#123A26">
                            <StackPanel Margin="8,2,0,2">
                                <Button x:Name="ConfigurationNavButton" ToolTip="Edit server.properties" Style="{StaticResource NavigationButton}" Click="Configuration_Click"><StackPanel Orientation="Horizontal"><Border Style="{StaticResource NavIconTile}"><Image Source="{StaticResource PixelIconConfiguration}" Width="28" Height="28" Stretch="None" SnapsToDevicePixels="True"/></Border><TextBlock Text="Server Configuration" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/></StackPanel></Button>
                                <Button x:Name="BackupsNavButton" ToolTip="Create and restore server backups" Style="{StaticResource NavigationButton}" Click="Backups_Click"><StackPanel Orientation="Horizontal"><Border Style="{StaticResource NavIconTile}"><Image Source="{StaticResource PixelIconBackups}" Width="28" Height="28" Stretch="None" SnapsToDevicePixels="True"/></Border><TextBlock Text="Backups" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/></StackPanel></Button>
                                <Button x:Name="PluginsNavButton" ToolTip="Install and manage server plugins" Style="{StaticResource NavigationButton}" Click="Plugins_Click"><StackPanel Orientation="Horizontal"><Border Style="{StaticResource NavIconTile}"><Image Source="{StaticResource PixelIconPlugins}" Width="28" Height="28" Stretch="None" SnapsToDevicePixels="True"/></Border><TextBlock Text="Plugin Manager" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/></StackPanel></Button>
                                <Button x:Name="WorldsNavButton" ToolTip="Inspect, back up, import, rename, and remove worlds" Style="{StaticResource NavigationButton}" Click="Worlds_Click"><StackPanel Orientation="Horizontal"><Border Style="{StaticResource NavIconTile}"><Image Source="{StaticResource PixelIconWorlds}" Width="28" Height="28" Stretch="None" SnapsToDevicePixels="True"/></Border><TextBlock Text="World Manager" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/></StackPanel></Button>
                                <Button x:Name="ManagementNavButton" ToolTip="Manage, verify, duplicate, move, import, and export servers" Style="{StaticResource NavigationButton}" Click="Management_Click"><StackPanel Orientation="Horizontal"><Border Style="{StaticResource NavIconTile}"><Image Source="{StaticResource PixelIconManagement}" Width="28" Height="28" Stretch="None" SnapsToDevicePixels="True"/></Border><TextBlock Text="Server Management" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/></StackPanel></Button>
                                <Button x:Name="UpdatesNavButton" ToolTip="Check for and safely install server updates" Style="{StaticResource NavigationButton}" Click="Updates_Click"><StackPanel Orientation="Horizontal"><Border Style="{StaticResource NavIconTile}"><TextBlock Text="↻" FontSize="21" FontWeight="Bold" Foreground="#2F9A2B" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="Update Center" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/></StackPanel></Button>
                            </StackPanel>
                        </Expander>

                        <Expander Header="AUTOMATION" IsExpanded="False" Margin="0,2,0,0" FontWeight="SemiBold" Foreground="#123A26">
                            <StackPanel Margin="8,2,0,2">
                                <Button x:Name="ScheduledTasksNavButton" ToolTip="Schedule restarts, commands, broadcasts, and update checks" Style="{StaticResource NavigationButton}" Click="ScheduledTasks_Click"><StackPanel Orientation="Horizontal"><Border Style="{StaticResource NavIconTile}"><TextBlock Text="◷" FontSize="21" FontWeight="Bold" Foreground="#2F9A2B" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="Scheduled Tasks" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/></StackPanel></Button>
                                <Button x:Name="NotificationsNavButton" ToolTip="Review server and manager notifications" Style="{StaticResource NavigationButton}" Click="Notifications_Click"><StackPanel Orientation="Horizontal"><Border Style="{StaticResource NavIconTile}"><TextBlock Text="!" FontSize="21" FontWeight="Bold" Foreground="#2F9A2B" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="Notifications" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/></StackPanel></Button>
                            </StackPanel>
                        </Expander>

                        <Expander Header="SERVER INTELLIGENCE" IsExpanded="False" Margin="0,2,0,0" FontWeight="SemiBold" Foreground="#123A26">
                            <StackPanel Margin="8,2,0,2">
                                <Button x:Name="HealthAnalyzerNavButton" ToolTip="Analyze server health and configuration" Style="{StaticResource NavigationButton}" Click="HealthAnalyzer_Click"><StackPanel Orientation="Horizontal"><Border Style="{StaticResource NavIconTile}"><TextBlock Text="♥" FontSize="19" FontWeight="Bold" Foreground="#2F9A2B" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="Health Analyzer" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/></StackPanel></Button>
                                <Button x:Name="StartupAnalyzerNavButton" ToolTip="Analyze startup timing and slow stages" Style="{StaticResource NavigationButton}" Click="StartupAnalyzer_Click"><StackPanel Orientation="Horizontal"><Border Style="{StaticResource NavIconTile}"><TextBlock Text="▶" FontSize="17" FontWeight="Bold" Foreground="#2F9A2B" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="Startup Analyzer" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/></StackPanel></Button>
                                <Button x:Name="LogAnalyzerNavButton" ToolTip="Scan logs for common errors" Style="{StaticResource NavigationButton}" Click="LogAnalyzer_Click"><StackPanel Orientation="Horizontal"><Border Style="{StaticResource NavIconTile}"><TextBlock Text="≡" FontSize="20" FontWeight="Bold" Foreground="#2F9A2B" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="Log Analyzer" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/></StackPanel></Button>
                                <Button x:Name="PluginCompatibilityNavButton" ToolTip="Check installed plugin compatibility" Style="{StaticResource NavigationButton}" Click="PluginCompatibility_Click"><StackPanel Orientation="Horizontal"><Border Style="{StaticResource NavIconTile}"><TextBlock Text="✓" FontSize="18" FontWeight="Bold" Foreground="#2F9A2B" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="Plugin Compatibility" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/></StackPanel></Button>
                                <Button x:Name="PerformanceDashboardNavButton" ToolTip="View performance snapshots" Style="{StaticResource NavigationButton}" Click="PerformanceDashboard_Click"><StackPanel Orientation="Horizontal"><Border Style="{StaticResource NavIconTile}"><TextBlock Text="▥" FontSize="18" FontWeight="Bold" Foreground="#2F9A2B" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="Performance" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/></StackPanel></Button>
                                <Button x:Name="OptimizationNavButton" ToolTip="Generate optimization recommendations" Style="{StaticResource NavigationButton}" Click="Optimization_Click"><StackPanel Orientation="Horizontal"><Border Style="{StaticResource NavIconTile}"><TextBlock Text="⚡" FontSize="18" Foreground="#2F9A2B" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="Optimization" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/></StackPanel></Button>
                            </StackPanel>
                        </Expander>

                        <Expander Header="HELP &amp; SETUP" IsExpanded="False" ToolTip="Setup assistance and application information" Margin="0,2,0,0" FontWeight="SemiBold" Foreground="#123A26">
                            <StackPanel Margin="8,2,0,2">
                                <Button x:Name="FirstRunWizardNavButton" ToolTip="Open the guided first-run setup" Style="{StaticResource NavigationButton}" Click="FirstRunWizard_Click"><StackPanel Orientation="Horizontal"><Border Style="{StaticResource NavIconTile}"><TextBlock Text="1" FontSize="18" FontWeight="Bold" Foreground="#2F9A2B" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="First Run Wizard" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/></StackPanel></Button>
                                <Button x:Name="AboutNavButton" ToolTip="About this application" Style="{StaticResource NavigationButton}" Click="About_Click"><StackPanel Orientation="Horizontal"><Border Style="{StaticResource NavIconTile}"><Image Source="{StaticResource PixelIconAbout}" Width="28" Height="28" Stretch="None" SnapsToDevicePixels="True"/></Border><TextBlock Text="About" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/></StackPanel></Button>
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- CENTER: SERVER LIST AND MAIN PAGES -->
        <Border Grid.Column="1" Background="#FAFBFC" BorderBrush="#E1E5E8" BorderThickness="0,0,1,0" Padding="14,16,12,16">
            <TabControl x:Name="MainTabs" SelectionChanged="MainTabs_SelectionChanged" Background="Transparent" BorderThickness="0">
                <TabControl.Resources><Style TargetType="TabItem"><Setter Property="Visibility" Value="Collapsed"/></Style></TabControl.Resources>
                <TabItem Header="Dashboard">
                    <pages:DashboardView x:Name="DashboardPage"/>
                </TabItem>

                <TabItem Header="Create Server">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

                        <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,0,14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <Button x:Name="CreateStep1Button" Tag="1" Click="CreateStep_Click" Content="1  BASICS" MinHeight="42"/>
                                <Button x:Name="CreateStep2Button" Grid.Column="2" Tag="2" Click="CreateStep_Click" Content="2  MINECRAFT" MinHeight="42"/>
                                <Button x:Name="CreateStep3Button" Grid.Column="4" Tag="3" Click="CreateStep_Click" Content="3  RESOURCES" MinHeight="42"/>
                                <Button x:Name="CreateStep4Button" Grid.Column="6" Tag="4" Click="CreateStep_Click" Content="4  SETTINGS" MinHeight="42"/>
                                <Button x:Name="CreateStep5Button" Grid.Column="8" Tag="5" Click="CreateStep_Click" Content="5  REVIEW" MinHeight="42"/>
                            </Grid>
                        </Border>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel>
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="CREATE A MINECRAFT SERVER" Style="{StaticResource SectionHeader}"/>
                                        <TextBlock Text="Complete each step, review the settings, and then create the server." Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" Margin="0,0,0,20"/>

                                        <StackPanel x:Name="CreateStep1Panel">
                                            <TextBlock Text="1  SERVER BASICS" Style="{StaticResource SectionHeader}"/>
                                            <TextBlock Text="Give the server a name and choose where its files will be stored." Foreground="{StaticResource TextSecondary}" Margin="0,0,0,16"/>
                                            <TextBlock Text="SERVER NAME" Style="{StaticResource FieldCaption}"/>
                                            <TextBox x:Name="ServerNameBox" Text="My Minecraft Server" TextChanged="ServerNameBox_TextChanged" MinHeight="42" Margin="0,5,0,0"/>
                                            <TextBlock Text="This name appears in the manager and is used to suggest the folder name." Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="0,5,0,16" TextWrapping="Wrap"/>
                                            <TextBlock Text="INSTALLATION LOCATION" Style="{StaticResource FieldCaption}"/>
                                            <Grid Margin="0,5,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition Width="110"/></Grid.ColumnDefinitions><TextBox x:Name="InstallFolderBox" MinHeight="42" TextChanged="CreateForm_Changed"/><Button Grid.Column="2" Style="{StaticResource LightButton}" Content="Browse" Margin="0" Click="BrowseInstall_Click"/></Grid>
                                            <TextBlock Text="Default location: C:\GameServers. Use an empty folder for a new server." Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="0,5,0,0" TextWrapping="Wrap"/>
                                        </StackPanel>

                                        <StackPanel x:Name="CreateStep2Panel" Visibility="Collapsed">
                                            <TextBlock Text="2  MINECRAFT" Style="{StaticResource SectionHeader}"/>
                                            <TextBlock Text="Choose the server software and Minecraft version." Foreground="{StaticResource TextSecondary}" Margin="0,0,0,16"/>
                                            <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="20"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                                <StackPanel><TextBlock Text="SERVER TYPE" Style="{StaticResource FieldCaption}"/><ComboBox x:Name="ServerTypeCombo" SelectionChanged="ServerTypeCombo_SelectionChanged"><ComboBoxItem Content="Paper" IsSelected="True"/><ComboBoxItem Content="Purpur"/><ComboBoxItem Content="Vanilla"/><ComboBoxItem Content="Custom JAR"/></ComboBox><TextBlock x:Name="ServerTypeHelpText" Text="Recommended for most servers. Fast and supports plugins." Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="0,5,0,0" TextWrapping="Wrap"/></StackPanel>
                                                <StackPanel Grid.Column="2"><TextBlock Text="MINECRAFT VERSION" Style="{StaticResource FieldCaption}"/><ComboBox x:Name="VersionCombo" IsEditable="True" ToolTip="Select or enter a Minecraft version" SelectionChanged="CreateForm_Changed"/></StackPanel>
                                            </Grid>
                                            <StackPanel x:Name="CustomJarPanel" Margin="0,18,0,0" Visibility="Collapsed"><TextBlock Text="CUSTOM SERVER JAR" Style="{StaticResource FieldCaption}"/><Grid Margin="0,5,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition Width="110"/></Grid.ColumnDefinitions><TextBox x:Name="CustomJarBox" MinHeight="42" TextChanged="CreateForm_Changed"/><Button Grid.Column="2" Style="{StaticResource LightButton}" Content="Browse" Margin="0" Click="BrowseJar_Click"/></Grid></StackPanel>
                                        </StackPanel>

                                        <StackPanel x:Name="CreateStep3Panel" Visibility="Collapsed">
                                            <TextBlock Text="3  RESOURCES" Style="{StaticResource SectionHeader}"/>
                                            <TextBlock Text="Choose how much memory the server may use." Foreground="{StaticResource TextSecondary}" Margin="0,0,0,16"/>
                                            <TextBlock Text="MEMORY ALLOCATION" Style="{StaticResource FieldCaption}"/>
                                            <ComboBox x:Name="MemoryCombo" SelectionChanged="CreateForm_Changed" MaxWidth="360" HorizontalAlignment="Left"><ComboBoxItem Content="2 GB"/><ComboBoxItem Content="4 GB" IsSelected="True"/><ComboBoxItem Content="6 GB"/><ComboBoxItem Content="8 GB"/><ComboBoxItem Content="12 GB"/><ComboBoxItem Content="16 GB"/></ComboBox>
                                            <Border Background="#EEF7F1" CornerRadius="10" Padding="14" Margin="0,18,0,0"><TextBlock Text="4 GB is recommended for a small Paper server. Increase memory for more players, plugins, or larger worlds." Foreground="#214E34" TextWrapping="Wrap" FontWeight="SemiBold"/></Border>
                                        </StackPanel>

                                        <StackPanel x:Name="CreateStep4Panel" Visibility="Collapsed">
                                            <TextBlock Text="4  SERVER SETTINGS" Style="{StaticResource SectionHeader}"/>
                                            <TextBlock Text="These common settings are written to server.properties during installation." Foreground="{StaticResource TextSecondary}" Margin="0,0,0,16"/>
                                            <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="20"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                                <StackPanel><TextBlock Text="SERVER PORT" Style="{StaticResource FieldCaption}"/><TextBox x:Name="ServerPortBox" Text="25565" MinHeight="42" TextChanged="CreateForm_Changed"/></StackPanel>
                                                <StackPanel Grid.Column="2"><TextBlock Text="MAX PLAYERS" Style="{StaticResource FieldCaption}"/><TextBox x:Name="MaxPlayersBox" Text="20" MinHeight="42" TextChanged="CreateForm_Changed"/></StackPanel>
                                            </Grid>
                                            <Grid Margin="0,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="20"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                                <StackPanel><TextBlock Text="DIFFICULTY" Style="{StaticResource FieldCaption}"/><ComboBox x:Name="DifficultyCombo" SelectionChanged="CreateForm_Changed"><ComboBoxItem Content="Peaceful"/><ComboBoxItem Content="Easy"/><ComboBoxItem Content="Normal" IsSelected="True"/><ComboBoxItem Content="Hard"/></ComboBox></StackPanel>
                                                <StackPanel Grid.Column="2"><TextBlock Text="ACCOUNT VERIFICATION" Style="{StaticResource FieldCaption}"/><CheckBox x:Name="OnlineModeCheckBox" Content="Online mode (recommended)" IsChecked="True" Margin="0,12,0,0" Checked="CreateForm_Changed" Unchecked="CreateForm_Changed"/></StackPanel>
                                            </Grid>
                                        </StackPanel>

                                        <StackPanel x:Name="CreateStep5Panel" Visibility="Collapsed">
                                            <TextBlock Text="5  REVIEW AND CREATE" Style="{StaticResource SectionHeader}"/>
                                            <TextBlock x:Name="BuildReviewText" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" Margin="0,0,0,16" FontSize="14"/>
                                            <CheckBox x:Name="EulaCheckBox" Checked="CreateForm_Changed" Unchecked="CreateForm_Changed"><TextBlock TextWrapping="Wrap">I have read and agree to the Minecraft End User License Agreement. The manager may write eula=true for this server.</TextBlock></CheckBox>
                                            <TextBlock x:Name="BuildValidationText" Foreground="#B3261E" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,12,0,0"/>
                                            <Grid Margin="0,18,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition Width="120"/></Grid.ColumnDefinitions><Button x:Name="BuildServerButton" Style="{StaticResource GreenActionButton}" MinHeight="52" HorizontalAlignment="Stretch" Margin="0" Click="BuildServer_Click" Content="CREATE SERVER"/><Button x:Name="CancelBuildButton" Grid.Column="2" Style="{StaticResource AmberActionButton}" Content="Cancel" Margin="0" Click="CancelBuild_Click" IsEnabled="False"/></Grid>
                                            <ProgressBar x:Name="BuildProgress" Height="10" Margin="0,16,0,0"/>
                                            <TextBlock x:Name="BuildMessage" Foreground="{StaticResource TextSecondary}" Margin="0,10,0,0" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>

                        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="14" Margin="0,14,0,0">
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition/><ColumnDefinition Width="130"/></Grid.ColumnDefinitions>
                                <Button x:Name="CreatePreviousButton" Style="{StaticResource SecondaryButton}" Content="← Previous" Click="CreatePrevious_Click"/>
                                <TextBlock x:Name="CreateStepStatusText" Grid.Column="1" Text="Step 1 of 5" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" Foreground="{StaticResource TextSecondary}"/>
                                <Button x:Name="CreateNextButton" Grid.Column="2" Style="{StaticResource PrimaryButton}" Content="Next →" Click="CreateNext_Click"/>
                            </Grid>
                        </Border>
                    </Grid>
                </TabItem>

                <TabItem Header="Console">
                    <pages:ConsoleView x:Name="ConsolePage"/>
                </TabItem>

                <TabItem Header="Server Configuration">
                    <pages:ConfigurationView x:Name="ConfigurationPage"/>
                </TabItem>
                <TabItem Header="Backups">
                    <pages:BackupsView x:Name="BackupsPage"/>
                </TabItem>
                <TabItem Header="Plugin Manager">
                    <pages:PluginManagerView x:Name="PluginManagerPage"/>
                </TabItem>
                <TabItem Header="World Manager">
                    <pages:WorldManagerView x:Name="WorldManagerPage"/>
                </TabItem>
                <TabItem Header="Server Management">
                    <pages:ServerManagementView x:Name="ServerManagementPage"/>
                </TabItem>
                <TabItem Header="Update Center">
                    <pages:UpdateCenterView x:Name="UpdateCenterPage"/>
                </TabItem>
                <TabItem Header="Scheduled Tasks">
                    <pages:ScheduledTasksView x:Name="ScheduledTasksPage"/>
                </TabItem>
                <TabItem Header="Notification Center">
                    <pages:NotificationCenterView x:Name="NotificationCenterPage"/>
                </TabItem>
                <TabItem Header="Health Analyzer">
                    <pages:HealthAnalyzerView x:Name="HealthAnalyzerPage"/>
                </TabItem>
                <TabItem Header="Startup Analyzer">
                    <pages:StartupAnalyzerView x:Name="StartupAnalyzerPage"/>
                </TabItem>
                <TabItem Header="Log Analyzer">
                    <pages:LogAnalyzerView x:Name="LogAnalyzerPage"/>
                </TabItem>
                <TabItem Header="Plugin Compatibility">
                    <pages:PluginCompatibilityView x:Name="PluginCompatibilityPage"/>
                </TabItem>
                <TabItem Header="Performance Dashboard">
                    <pages:PerformanceDashboardView x:Name="PerformanceDashboardPage"/>
                </TabItem>
                <TabItem Header="Optimization Recommendations">
                    <pages:OptimizationView x:Name="OptimizationPage"/>
                </TabItem>
                <TabItem Header="First Run Wizard">
                    <pages:FirstRunWizardView x:Name="FirstRunWizardPage"/>
                </TabItem>
                <TabItem Header="About"><ScrollViewer VerticalScrollBarVisibility="Auto"><Border Style="{StaticResource Card}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="24"/><ColumnDefinition/></Grid.ColumnDefinitions><Image Source="Assets/brand.png" Width="145" Height="178" Stretch="Uniform" VerticalAlignment="Top"/><StackPanel Grid.Column="2"><TextBlock Text="ABOUT" Style="{StaticResource SectionHeader}"/><TextBlock Text="A Simple Minecraft Server" FontSize="28" FontWeight="Bold" Foreground="{StaticResource DarkGreen}"/><TextBlock x:Name="AboutVersionText" Text="Version" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource Green}" Margin="0,4,0,16"/><TextBlock Text="A simple and easy-to-use Minecraft server manager for Windows. Build, manage, monitor, and launch Minecraft Java servers from one place." FontSize="14" TextWrapping="Wrap" MaxWidth="500"/><Border Height="1" Background="#E6E9EB" Margin="0,20,0,20"/><TextBlock Text="SUPPORTED SERVER TYPES" FontWeight="Bold"/><WrapPanel Margin="0,10,0,18"><Border Background="#EAF6E3" CornerRadius="5" Padding="10,5" Margin="0,0,8,8"><TextBlock Text="Paper" Foreground="#218522"/></Border><Border Background="#E3F2FD" CornerRadius="5" Padding="10,5" Margin="0,0,8,8"><TextBlock Text="Vanilla" Foreground="#1769AA"/></Border><Border Background="#F3E5F5" CornerRadius="5" Padding="10,5" Margin="0,0,8,8"><TextBlock Text="Purpur" Foreground="#7B3FA1"/></Border><Border Background="#FFF3E0" CornerRadius="5" Padding="10,5" Margin="0,0,8,8"><TextBlock Text="Custom JAR" Foreground="#A85A00"/></Border></WrapPanel><TextBlock Text="This application is not affiliated with Mojang, Microsoft, PaperMC, or PurpurMC." Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap"/><TextBlock Text="© 2026 A Simple Minecraft Server" Foreground="#899198" Margin="0,22,0,0"/></StackPanel></Grid></Border></ScrollViewer></TabItem>
            </TabControl>
        </Border>

        <!-- RIGHT: SELECTED SERVER -->
        <Border Grid.Column="2" Background="#FAFBFC" Padding="12,16,16,16">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border Style="{StaticResource Card}" Padding="0">
                        <StackPanel>
                            <Border Background="#173D2A" CornerRadius="14,14,0,0" Padding="22,20">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="SELECTED SERVER" Foreground="#BFE4C7" FontSize="12" FontWeight="Bold"/>
                                        <TextBlock x:Name="SelectedName" Text="No server selected" FontSize="25" FontWeight="Bold" Foreground="White" Margin="0,5,0,0" TextWrapping="Wrap"/>
                                        <TextBlock x:Name="NoSelectionHintText" Text="Choose a server from the Dashboard list, create a new one, or add an existing server folder." Foreground="#D4E6D8" TextWrapping="Wrap" Margin="0,8,0,0"/><TextBlock x:Name="SelectedServerSubtitleText" Text="" Foreground="#D4E6D8" TextWrapping="Wrap" Margin="0,7,0,0" Visibility="Collapsed"/>
                                    </StackPanel>
                                    <Border x:Name="RuntimeStatusBadge" Grid.Column="1" Background="#53606A" CornerRadius="14" Padding="12,7" VerticalAlignment="Top" Margin="12,0,0,0">
                                        <StackPanel Orientation="Horizontal"><Ellipse x:Name="HeaderStatusDot" Width="10" Height="10" Fill="White" Margin="0,3,7,0"/><TextBlock x:Name="HealthStatusText" Text="No server selected" Foreground="White" FontWeight="Bold"/></StackPanel>
                                    </Border>
                                </Grid>
                            </Border>
                            <Grid Margin="18,16,18,18">
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <Button x:Name="StartServerButton" Style="{StaticResource GreenActionButton}" Content="START" MinHeight="48" Click="Start_Click"/>
                                <Button x:Name="RestartServerButton" Grid.Column="1" Style="{StaticResource AmberActionButton}" Content="RESTART" MinHeight="48" Click="Restart_Click"/>
                                <Button x:Name="StopServerButton" Grid.Column="2" Style="{StaticResource DangerActionButton}" Content="STOP" MinHeight="48" Click="Stop_Click"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Expander x:Name="LivePerformanceExpander" Margin="0,10,0,0" Header="Live Performance" IsExpanded="True" FontWeight="Bold">
                        <Border Style="{StaticResource Card}" Padding="14,12" Effect="{x:Null}" Margin="0,6,0,0">
                            <StackPanel>
                            <UniformGrid Columns="3" Margin="-4,0,-4,0">
                                <Border Background="#F7F9FA" BorderBrush="#D9DEE2" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="4"><StackPanel><Border Height="3" Background="#3F9E2F" CornerRadius="2" Margin="0,0,0,7"/><TextBlock Text="STATE" Style="{StaticResource FieldCaption}"/><TextBlock x:Name="RuntimeStateValueText" Text="No server selected" FontSize="15" FontWeight="Bold" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/></StackPanel></Border>
                                <Border Background="#F7F9FA" BorderBrush="#D9DEE2" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="4"><StackPanel><Border Height="3" Background="#6E7B85" CornerRadius="2" Margin="0,0,0,7"/><TextBlock Text="UPTIME" Style="{StaticResource FieldCaption}"/><TextBlock x:Name="UptimeValueText" Text="—" FontSize="15" FontWeight="Bold" Margin="0,3,0,0"/></StackPanel></Border>
                                <Border Background="#F7F9FA" BorderBrush="#D9DEE2" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="4"><StackPanel><Border Height="3" Background="#2489D8" CornerRadius="2" Margin="0,0,0,7"/><TextBlock Text="CPU" Style="{StaticResource FieldCaption}"/><TextBlock x:Name="CpuUsageValueText" Text="—" FontSize="15" FontWeight="Bold" Margin="0,3,0,4"/><ProgressBar x:Name="CpuUsageBar" Maximum="100" Value="0" Foreground="#2489D8"/></StackPanel></Border>
                                <Border Background="#F7F9FA" BorderBrush="#D9DEE2" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="4"><StackPanel><Border Height="3" Background="#8B5ED2" CornerRadius="2" Margin="0,0,0,7"/><TextBlock Text="RAM IN USE" Style="{StaticResource FieldCaption}"/><TextBlock x:Name="ActionMemoryText" Text="—" FontSize="15" FontWeight="Bold" Margin="0,3,0,4"/><ProgressBar x:Name="MemoryUsageBar" Maximum="100" Value="0" Foreground="#8B5ED2"/></StackPanel></Border>
                                <Border Background="#F7F9FA" BorderBrush="#D9DEE2" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="4"><StackPanel><Border Height="3" Background="#7D858B" CornerRadius="2" Margin="0,0,0,7"/><TextBlock Text="DISK" Style="{StaticResource FieldCaption}"/><TextBlock x:Name="DiskUsageValueText" Text="—" FontSize="15" FontWeight="Bold" Margin="0,3,0,0"/></StackPanel></Border>
                                <Border Background="#F7F9FA" BorderBrush="#D9DEE2" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="4"><StackPanel><Border Height="3" Background="#F0B429" CornerRadius="2" Margin="0,0,0,7"/><TextBlock Text="PORT" Style="{StaticResource FieldCaption}"/><TextBlock x:Name="PortValueText" Text="—" FontSize="15" FontWeight="Bold" Margin="0,3,0,0"/></StackPanel></Border>
                            </UniformGrid>
                            <Grid Margin="4,8,4,0" Height="64">
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <Border Background="#F4F7F9" BorderBrush="#D9DEE2" BorderThickness="1" CornerRadius="7" Margin="0,0,4,0" Padding="8,6">
                                    <Grid><TextBlock Text="CPU • 60 SEC" Style="{StaticResource FieldCaption}"/><Canvas x:Name="CpuHistoryCanvas" Margin="0,18,0,0" Height="32" SizeChanged="PerformanceCanvas_SizeChanged"><Polyline x:Name="CpuHistoryLine" Stroke="#2489D8" StrokeThickness="2"/></Canvas></Grid>
                                </Border>
                                <Border Grid.Column="1" Background="#F4F7F9" BorderBrush="#D9DEE2" BorderThickness="1" CornerRadius="7" Margin="4,0,0,0" Padding="8,6">
                                    <Grid><TextBlock Text="RAM • 60 SEC" Style="{StaticResource FieldCaption}"/><Canvas x:Name="MemoryHistoryCanvas" Margin="0,18,0,0" Height="32" SizeChanged="PerformanceCanvas_SizeChanged"><Polyline x:Name="MemoryHistoryLine" Stroke="#8B5ED2" StrokeThickness="2"/></Canvas></Grid>
                                </Border>
                            </Grid>
                            <TextBlock Text="CPU and RAM are measured from the running Java server process. Graphs show the latest 60 samples. Disk shows the selected server folder size." Foreground="{StaticResource TextSecondary}" FontSize="11" TextWrapping="Wrap" Margin="4,6,4,0"/>
                            </StackPanel>
                        </Border>
                    </Expander>

                    <Expander x:Name="QuickToolsExpander" Margin="0,14,0,0" Header="Quick Tools" IsExpanded="True" FontWeight="Bold">
                        <Border Style="{StaticResource Card}" Margin="0,6,0,0">
                            <StackPanel>
                            <UniformGrid Columns="2" Rows="1" Margin="-4,0,-4,0">
                                <Button x:Name="ConsoleQuickButton" ToolTip="Open the live console for the selected server" Style="{StaticResource BlueQuickToolButton}" Click="Console_Click"><StackPanel><Border Style="{StaticResource QuickIconTile}" Background="#35FFFFFF"><Image Source="{StaticResource PixelIconConsole}" Width="28" Height="28" Stretch="None" SnapsToDevicePixels="True"/></Border><TextBlock Text="Open Console" HorizontalAlignment="Center" Margin="0,6,0,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" FontWeight="Bold"/></StackPanel></Button>
                                <Button x:Name="OpenFolderQuickButton" ToolTip="Open the selected server folder" Style="{StaticResource AmberQuickToolButton}" Click="OpenFolder_Click"><StackPanel><Border Style="{StaticResource QuickIconTile}" Background="#30FFFFFF"><Image Source="{StaticResource PixelIconFolder}" Width="28" Height="28" Stretch="None" SnapsToDevicePixels="True"/></Border><TextBlock Text="Open Folder" HorizontalAlignment="Center" Margin="0,6,0,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" FontWeight="Bold"/></StackPanel></Button>
                            </UniformGrid>
                            </StackPanel>
                        </Border>
                    </Expander>

                    <Expander x:Name="OnlinePlayersExpander" Margin="0,10,0,0" Header="Online Players" IsExpanded="True" FontWeight="Bold">
                        <Border Style="{StaticResource Card}" Padding="14,12" Effect="{x:Null}" Margin="0,6,0,0">
                            <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="ONLINE PLAYERS" Style="{StaticResource SectionHeader}" Margin="0,0,0,2"/>
                                    <TextBlock x:Name="PlayerCountText" Text="Server is offline" Foreground="{StaticResource TextSecondary}" FontSize="12"/>
                                </StackPanel>
                                <Button x:Name="RefreshPlayersButton" Grid.Column="1" Content="Refresh" Style="{StaticResource LightButton}" Padding="12,6" MinWidth="82" Click="RefreshPlayers_Click"/>
                            </Grid>
                            <Border Background="#F7F9FA" BorderBrush="#D9DEE2" BorderThickness="1" CornerRadius="8" MinHeight="128" MaxHeight="220">
                                <Grid>
                                    <ListBox x:Name="OnlinePlayersList" BorderThickness="0" Background="Transparent" Margin="5" SelectionChanged="OnlinePlayersList_SelectionChanged">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="5,4"><Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                                    <Border Width="23" Height="23" CornerRadius="5" Background="#E8F5E3" BorderBrush="#8CCA73" BorderThickness="1"><TextBlock Text="●" Foreground="#2F9A2B" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="10"/></Border>
                                                    <TextBlock Grid.Column="1" Text="{Binding}" FontWeight="SemiBold" Foreground="#172026" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    <TextBlock x:Name="NoPlayersText" Text="No players online" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Visible"/>
                                </Grid>
                            </Border>
                            <UniformGrid Columns="3" Margin="-3,9,-3,0">
                                <Button x:Name="MakeAdminButton" Content="Make Admin" Style="{StaticResource GreenActionButton}" Margin="3" Padding="7,8" Click="MakeAdmin_Click"/>
                                <Button x:Name="KickPlayerButton" Content="Kick" Style="{StaticResource AmberActionButton}" Margin="3" Padding="7,8" Click="KickPlayer_Click"/>
                                <Button x:Name="BanPlayerButton" Content="Ban" Style="{StaticResource DangerActionButton}" Margin="3" Padding="7,8" Click="BanPlayer_Click"/>
                            </UniformGrid>
                            <TextBlock x:Name="PlayerActionStatusText" Text="Start the selected server to monitor players." Foreground="{StaticResource TextSecondary}" FontSize="11" TextWrapping="Wrap" Margin="2,7,2,0"/>

                            <!-- Retained hidden compatibility fields; the same information is already presented in the selected-server header. -->
                            <StackPanel Visibility="Collapsed">
                                <TextBlock x:Name="ServerTypeBadgeText" Text="NO SERVER"/><TextBlock x:Name="VisibleVersionText" Text="—"/><TextBlock x:Name="VisibleJarText" Text="—"/><TextBlock x:Name="VisibleLocationText" Text="—"/><TextBlock x:Name="VisibleJavaText" Text="Detecting…"/>
                            </StackPanel>
                            </StackPanel>
                        </Border>
                    </Expander>

                    <Expander Margin="0,14,0,0" Header="Crash Recovery" IsExpanded="False" FontWeight="Bold">
                        <Border Style="{StaticResource Card}" Margin="0,6,0,0">
                            <StackPanel>
                                <CheckBox x:Name="CrashRecoveryCheckBox" Content="Automatically restart after an unexpected crash" Checked="CrashRecoverySettings_Changed" Unchecked="CrashRecoverySettings_Changed"/>
                                <Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                    <StackPanel><TextBlock Text="RESTART LIMIT" Style="{StaticResource FieldCaption}"/><ComboBox x:Name="CrashRecoveryLimitCombo" Margin="0,5,0,0" SelectionChanged="CrashRecoverySettings_Changed"><ComboBoxItem Content="1 restart" Tag="1"/><ComboBoxItem Content="2 restarts" Tag="2"/><ComboBoxItem Content="3 restarts" Tag="3"/><ComboBoxItem Content="5 restarts" Tag="5"/></ComboBox></StackPanel>
                                    <StackPanel Grid.Column="2"><TextBlock Text="RESTART DELAY" Style="{StaticResource FieldCaption}"/><ComboBox x:Name="CrashRecoveryDelayCombo" Margin="0,5,0,0" SelectionChanged="CrashRecoverySettings_Changed"><ComboBoxItem Content="5 seconds" Tag="5"/><ComboBoxItem Content="10 seconds" Tag="10"/><ComboBoxItem Content="30 seconds" Tag="30"/><ComboBoxItem Content="60 seconds" Tag="60"/></ComboBox></StackPanel>
                                </Grid>
                                <TextBlock x:Name="CrashRecoveryStatusText" Foreground="{StaticResource TextSecondary}" FontSize="11" TextWrapping="Wrap" Margin="0,10,0,0"/>
                            </StackPanel>
                        </Border>
                    </Expander>

                    <Expander Margin="0,14,0,0" Header="⚠  Danger Zone" Foreground="#B3261E" FontWeight="Bold">
                        <Border Style="{StaticResource Card}" BorderBrush="#E6B8B4" Effect="{x:Null}" Margin="0,6,0,0">
                            <StackPanel>
                                <TextBlock Text="Forget the server without deleting files, or permanently delete the complete server folder." Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Button x:Name="ForgetServerButton" Style="{StaticResource LightButton}" Content="Forget Server" ToolTip="Remove this server from the manager but keep all files." Click="RemoveServer_Click"/><Button x:Name="DeleteServerButton" Grid.Column="1" Style="{StaticResource DangerActionButton}" Content="Delete Server Files…" ToolTip="Permanently delete this server and its complete folder." Click="DeleteServer_Click"/></Grid>
                            </StackPanel>
                        </Border>
                    </Expander>

                    <TextBlock x:Name="SelectedDetails" Visibility="Collapsed"/><TextBlock x:Name="DashboardServerName" Visibility="Collapsed"/><TextBlock x:Name="DashboardServerDetails" Visibility="Collapsed"/><TextBlock x:Name="ActionStatusText" Visibility="Collapsed"/><TextBlock x:Name="StatusText" Visibility="Collapsed"/><TextBlock x:Name="ActionWorldText" Visibility="Collapsed"/><TextBlock x:Name="ActionJavaText" Visibility="Collapsed"/>
                    <Ellipse x:Name="SelectedStatusDot" Width="0" Height="0" Visibility="Collapsed"/>
                </StackPanel>
            </ScrollViewer>
        </Border>


        <!-- COMMAND PALETTE -->
        <Grid x:Name="CommandPaletteOverlay" Grid.ColumnSpan="3" Panel.ZIndex="1000" Background="#990A0F12" Visibility="Collapsed" MouseDown="CommandPaletteBackdrop_MouseDown">
            <Border Width="700" MaxHeight="610" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,88,0,0"
                    Background="#FDFEFE" BorderBrush="#6FBF54" BorderThickness="2" CornerRadius="14" Padding="0"
                    MouseDown="CommandPalettePanel_MouseDown">
                <Border.Effect><DropShadowEffect BlurRadius="30" ShadowDepth="8" Opacity="0.4"/></Border.Effect>
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Grid Margin="20,18,20,10">
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="COMMAND PALETTE" FontSize="13" FontWeight="Bold" Foreground="#2F9A2B"/>
                            <TextBlock Text="Find a page or run a server action" FontSize="20" FontWeight="Bold" Foreground="#172026" Margin="0,3,0,0"/>
                        </StackPanel>
                        <Border Grid.Column="1" Background="#EDF1F3" CornerRadius="6" Padding="8,4" VerticalAlignment="Center"><TextBlock Text="ESC" Foreground="#53606A" FontWeight="SemiBold"/></Border>
                    </Grid>
                    <Border Grid.Row="1" Margin="20,0,20,12" Background="#F3F6F7" BorderBrush="#BCC6CC" BorderThickness="1" CornerRadius="9" Padding="12,9">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <TextBlock Text="⌕" FontSize="22" Foreground="#4C5961" VerticalAlignment="Center"/>
                            <TextBox x:Name="CommandPaletteSearchBox" Grid.Column="1" Background="Transparent" BorderThickness="0" FontSize="17" Foreground="#172026" CaretBrush="#2F9A2B"
                                     TextChanged="CommandPaletteSearchBox_TextChanged" KeyDown="CommandPaletteSearchBox_KeyDown" ToolTip="Type to filter commands"/>
                        </Grid>
                    </Border>
                    <ListBox x:Name="CommandPaletteList" Grid.Row="2" Margin="12,0,12,0" Background="Transparent" BorderThickness="0" ScrollViewer.VerticalScrollBarVisibility="Auto"
                             MouseDoubleClick="CommandPaletteList_MouseDoubleClick">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="IsEnabled" Value="{Binding IsEnabled}"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="8,2"/>
                                <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="PaletteItem" Background="Transparent" CornerRadius="8" Padding="12,10"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="PaletteItem" Property="Background" Value="#E7F5E1"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="PaletteItem" Property="Background" Value="#F0F7ED"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="PaletteItem" Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <Border Width="28" Height="28" CornerRadius="17" Background="#E8F5E3" BorderBrush="#8CCA73" BorderThickness="1"><TextBlock Text="{Binding Icon}" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                    <StackPanel Grid.Column="1" Margin="10,0,12,0"><TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" Foreground="#172026"/><TextBlock Text="{Binding Description}" FontSize="12" Foreground="#6A757C" TextTrimming="CharacterEllipsis"/></StackPanel>
                                    <Border Grid.Column="2" Background="#EDF1F3" CornerRadius="5" Padding="7,3" VerticalAlignment="Center" Visibility="{Binding ShortcutVisibility}"><TextBlock Text="{Binding Shortcut}" FontSize="11" Foreground="#53606A" FontWeight="SemiBold"/></Border>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <Border Grid.Row="3" Background="#F4F7F8" BorderBrush="#DDE3E6" BorderThickness="0,1,0,0" CornerRadius="0,0,12,12" Padding="20,10">
                        <TextBlock x:Name="CommandPaletteHintText" Text="↑ ↓ Navigate    Enter Run    Esc Close" Foreground="#66737B" FontSize="12"/>
                    </Border>
                </Grid>
            </Border>
        </Grid>
        <TextBlock x:Name="PageTitle" Visibility="Collapsed"/>
    </Grid>
</Window>
