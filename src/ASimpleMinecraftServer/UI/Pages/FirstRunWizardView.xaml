<UserControl x:Class="ASimpleMinecraftServer.UI.Pages.FirstRunWizardView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><Border Style="{StaticResource Card}" Padding="22" Margin="0,0,0,14"><StackPanel><TextBlock Text="WELCOME" Style="{StaticResource SectionHeader}"/><TextBlock Text="Set up your first Minecraft server" FontSize="28" FontWeight="Bold" Foreground="{StaticResource DarkGreen}"/><TextBlock Text="This wizard checks the basic Windows environment, explains the next steps, and takes you directly into server creation." Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" Margin="0,8,0,0"/></StackPanel></Border><Border Style="{StaticResource Card}" Padding="18" Margin="0,0,0,14"><StackPanel><TextBlock Text="1  CHECK YOUR COMPUTER" FontWeight="Bold" FontSize="16"/><TextBlock x:Name="JavaStatusText" Text="Java: not checked" Margin="0,12,0,4"/><TextBlock x:Name="FolderStatusText" Text="Server folder: not checked" Margin="0,4"/><TextBlock x:Name="MemoryStatusText" Text="System memory: not checked" Margin="0,4,0,12"/><Button Content="Run Environment Check" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Padding="16,8" Click="Check_Click"/></StackPanel></Border><Border Style="{StaticResource Card}" Padding="18" Margin="0,0,0,14"><StackPanel><TextBlock Text="2  CREATE OR IMPORT" FontWeight="Bold" FontSize="16"/><TextBlock Text="Create a Paper, Purpur, Vanilla, or custom-JAR server. Existing server folders can be imported from the Dashboard." Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" Margin="0,10,0,12"/><Button Content="Create My First Server" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Padding="18,9" Click="Create_Click"/></StackPanel></Border><Border Style="{StaticResource Card}" Padding="18"><StackPanel><TextBlock Text="3  AFTER CREATION" FontWeight="Bold" FontSize="16"/><TextBlock Text="Accept the EULA, start the server, watch the live console, create a backup, and run the Health Analyzer. The manager keeps advanced tools available without forcing them into the basic workflow." Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" Margin="0,10,0,0"/></StackPanel></Border></StackPanel></ScrollViewer></UserControl>