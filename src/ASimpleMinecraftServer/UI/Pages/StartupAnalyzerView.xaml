<UserControl x:Class="ASimpleMinecraftServer.UI.Pages.StartupAnalyzerView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Border Style="{StaticResource Card}" Padding="18" Margin="0,0,0,12"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="STARTUP ANALYZER" Style="{StaticResource SectionHeader}"/><TextBlock x:Name="SummaryText" Text="Inspect the latest startup log for timing and slow stages." Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap"/></StackPanel><Button x:Name="AnalyzeButton" Grid.Column="1" Content="Analyze Startup" Style="{StaticResource PrimaryButton}" Padding="16,8" Click="Analyze_Click"/></Grid></Border><Border Grid.Row="1" Style="{StaticResource Card}" Padding="14" Margin="0,0,0,12"><StackPanel Orientation="Horizontal"><TextBlock Text="Startup time: " FontWeight="SemiBold"/><TextBlock x:Name="StartupTimeText" Text="—"/><TextBlock Text="    Warnings: " FontWeight="SemiBold"/><TextBlock x:Name="WarningText" Text="—"/></StackPanel></Border><Border Grid.Row="2" Style="{StaticResource Card}" Padding="10"><DataGrid x:Name="MetricsGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"><DataGrid.Columns><DataGridTextColumn Header="Stage" Binding="{Binding Stage}" Width="170"/><DataGridTextColumn Header="Duration" Binding="{Binding Duration}" Width="100"/><DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="110"/><DataGridTextColumn Header="Detail" Binding="{Binding Detail}" Width="*"/></DataGrid.Columns></DataGrid></Border></Grid></UserControl>