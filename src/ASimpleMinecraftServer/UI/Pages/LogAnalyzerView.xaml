<UserControl x:Class="ASimpleMinecraftServer.UI.Pages.LogAnalyzerView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Border Style="{StaticResource Card}" Padding="18" Margin="0,0,0,12"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="LOG ANALYZER" Style="{StaticResource SectionHeader}"/><TextBlock x:Name="SummaryText" Text="Scan latest.log for common Java, plugin, dependency, and memory problems." Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap"/></StackPanel><Button x:Name="AnalyzeButton" Grid.Column="1" Content="Analyze Log" Style="{StaticResource PrimaryButton}" Padding="16,8" Click="Analyze_Click"/></Grid></Border><Border Grid.Row="1" Style="{StaticResource Card}" Padding="10"><DataGrid x:Name="FindingsGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"><DataGrid.Columns><DataGridTextColumn Header="Severity" Binding="{Binding Severity}" Width="90"/><DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="150"/><DataGridTextColumn Header="Finding" Binding="{Binding Message}" Width="2*"/><DataGridTextColumn Header="Suggested action" Binding="{Binding SuggestedAction}" Width="2*"/></DataGrid.Columns></DataGrid></Border></Grid></UserControl>