<UserControl x:Class="ASimpleMinecraftServer.UI.Pages.UpdateCenterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <Border Style="{StaticResource Card}" Padding="0">
                <StackPanel>
                    <Border Background="#173D2A" CornerRadius="14,14,0,0" Padding="22,18">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel><TextBlock Text="UPDATE CENTER" Foreground="White" FontSize="24" FontWeight="Bold"/><TextBlock Text="Safely check, back up, and update the selected Minecraft server." Foreground="#D4E6D8" Margin="0,5,0,0"/></StackPanel>
                            <Button Grid.Column="1" Style="{StaticResource GreenActionButton}" Content="CHECK NOW" Click="Check_Click" MinWidth="125"/>
                        </Grid>
                    </Border>
                    <Grid Margin="22"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="20"/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="SELECTED SERVER" Style="{StaticResource FieldCaption}"/>
                            <TextBlock x:Name="ServerNameText" Text="No server selected" FontSize="21" FontWeight="Bold" Foreground="{StaticResource DarkGreen}" Margin="0,4,0,4"/>
                            <TextBlock x:Name="ServerTypeText" Foreground="{StaticResource TextSecondary}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="UPDATE STATUS" Style="{StaticResource FieldCaption}"/>
                            <TextBlock x:Name="StatusText" Text="Select a server and check for updates." FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                <StackPanel>
                    <TextBlock Text="SERVER SOFTWARE" Style="{StaticResource SectionHeader}"/>
                    <Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <StackPanel><TextBlock Text="MINECRAFT VERSION" Style="{StaticResource FieldCaption}"/><TextBlock x:Name="MinecraftVersionText" Text="—" FontSize="18" FontWeight="Bold"/></StackPanel>
                        <StackPanel Grid.Column="1"><TextBlock Text="INSTALLED BUILD" Style="{StaticResource FieldCaption}"/><TextBlock x:Name="InstalledBuildText" Text="—" FontSize="18" FontWeight="Bold"/></StackPanel>
                        <StackPanel Grid.Column="2"><TextBlock Text="LATEST BUILD" Style="{StaticResource FieldCaption}"/><TextBlock x:Name="LatestBuildText" Text="—" FontSize="18" FontWeight="Bold"/></StackPanel>
                    </Grid>
                    <TextBlock x:Name="SummaryText" Text="No update check has been performed." Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" Margin="0,18,0,0"/>
                    <ProgressBar x:Name="UpdateProgress" Height="10" Margin="0,16,0,0" Minimum="0" Maximum="100"/>
                    <TextBlock x:Name="ProgressText" Foreground="{StaticResource TextSecondary}" Margin="0,8,0,0"/>
                    <WrapPanel Margin="0,18,0,0">
                        <Button x:Name="InstallButton" Style="{StaticResource GreenActionButton}" Content="BACK UP &amp; INSTALL" Click="Install_Click" IsEnabled="False" MinWidth="180"/>
                        <Button Style="{StaticResource SecondaryButton}" Content="OPEN SERVER FOLDER" Click="OpenFolder_Click" MinWidth="165"/>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                <StackPanel>
                    <TextBlock Text="CHANGE MINECRAFT VERSION" Style="{StaticResource SectionHeader}"/>
                    <TextBlock Text="Choose a different Minecraft release for the selected server. Worlds, plugins, and configuration are preserved, but plugins may need updates after changing versions." TextWrapping="Wrap" Foreground="{StaticResource TextSecondary}" Margin="0,6,0,12"/>
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <ComboBox x:Name="TargetVersionCombo" MinHeight="38" IsEditable="False"/>
                        <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Content="LOAD VERSIONS" Click="LoadVersions_Click" MinWidth="135" Margin="10,0,0,0"/>
                        <Button x:Name="ChangeVersionButton" Grid.Column="2" Style="{StaticResource GreenActionButton}" Content="BACK UP &amp; CHANGE" Click="ChangeVersion_Click" MinWidth="165" Margin="10,0,0,0" IsEnabled="False"/>
                    </Grid>
                    <TextBlock x:Name="VersionChangeStatusText" Text="Load the available releases to begin." Foreground="{StaticResource TextSecondary}" Margin="0,10,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                <StackPanel>
                    <TextBlock Text="SAFETY WORKFLOW" Style="{StaticResource SectionHeader}"/>
                    <TextBlock Text="1. Require the server to be stopped&#x0a;2. Create a complete safety backup&#x0a;3. Download and validate the new JAR&#x0a;4. Preserve the previous JAR beside the server&#x0a;5. Replace the active JAR and record the installed build&#x0a;6. Restore the previous JAR automatically if installation fails" TextWrapping="Wrap" Foreground="{StaticResource TextSecondary}" LineHeight="24"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
