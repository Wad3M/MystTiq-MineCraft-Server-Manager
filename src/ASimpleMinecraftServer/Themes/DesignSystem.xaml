<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Core palette -->
    <SolidColorBrush x:Key="Green" Color="#3F9E2F"/>
    <SolidColorBrush x:Key="DarkGreen" Color="#23652B"/>
    <SolidColorBrush x:Key="LightGreen" Color="#EEF8EA"/>
    <SolidColorBrush x:Key="TextPrimary" Color="#20262D"/>
    <SolidColorBrush x:Key="TextSecondary" Color="#66717A"/>
    <SolidColorBrush x:Key="Border" Color="#D9DEE2"/>
    <SolidColorBrush x:Key="BorderStrong" Color="#C6CDD2"/>
    <SolidColorBrush x:Key="Surface" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SurfaceSubtle" Color="#F7F9FA"/>
    <SolidColorBrush x:Key="InputBackground" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="StatusBlue" Color="#1677B8"/>
    <SolidColorBrush x:Key="StatusAmber" Color="#B66D00"/>
    <SolidColorBrush x:Key="StatusOrange" Color="#C45712"/>
    <SolidColorBrush x:Key="StatusRed" Color="#C93232"/>
    <SolidColorBrush x:Key="StatusGray" Color="#7D858B"/>
    <SolidColorBrush x:Key="DangerSurface" Color="#FFF4F3"/>
    <SolidColorBrush x:Key="DangerBorder" Color="#E7A09B"/>
    <SolidColorBrush x:Key="ActionBlue" Color="#146FB3"/>
    <SolidColorBrush x:Key="ActionBlueDark" Color="#0C568F"/>
    <SolidColorBrush x:Key="ActionBlueHover" Color="#2489D8"/>
    <SolidColorBrush x:Key="ActionBluePressed" Color="#0A4F85"/>
    <SolidColorBrush x:Key="ActionAmber" Color="#F0B429"/>
    <SolidColorBrush x:Key="ActionAmberDark" Color="#C88700"/>
    <SolidColorBrush x:Key="ActionAmberHover" Color="#FFD15A"/>
    <SolidColorBrush x:Key="ActionAmberPressed" Color="#D79A08"/>
    <SolidColorBrush x:Key="ActionPurple" Color="#7042B5"/>
    <SolidColorBrush x:Key="ActionPurpleDark" Color="#58338F"/>
    <SolidColorBrush x:Key="ActionPurpleHover" Color="#8B5ED2"/>
    <SolidColorBrush x:Key="ActionRed" Color="#C9342F"/>
    <SolidColorBrush x:Key="ActionRedDark" Color="#9F2925"/>
    <SolidColorBrush x:Key="ActionRedHover" Color="#E34A43"/>
    <SolidColorBrush x:Key="ActionGreenHover" Color="#70D34A"/>
    <!-- UX 2.4 navigation and interaction palette -->
    <SolidColorBrush x:Key="NavigationHover" Color="#E9F5E5"/>
    <SolidColorBrush x:Key="NavigationHoverBorder" Color="#83C96B"/>
    <SolidColorBrush x:Key="NavigationSelected" Color="#257A32"/>
    <SolidColorBrush x:Key="NavigationSelectedHover" Color="#319843"/>
    <SolidColorBrush x:Key="TileDashboard" Color="#3FAE3A"/>
    <SolidColorBrush x:Key="TileCreate" Color="#2588D8"/>
    <SolidColorBrush x:Key="TileConsole" Color="#8656CF"/>
    <SolidColorBrush x:Key="TileAbout" Color="#168D9A"/>


    <!-- Minecraft-styled semantic icons: each image keeps the familiar meaning of the action. -->
    <DrawingImage x:Key="PixelIconDashboard">
        <DrawingImage.Drawing><DrawingGroup>
            <!-- Minecraft compass -->
            <GeometryDrawing Brush="#332A25" Geometry="M2,8 H8 V2 H26 V8 H32 V26 H26 V32 H8 V26 H2 Z"/>
            <GeometryDrawing Brush="#D7D9D8" Geometry="M8,5 H26 V9 H29 V25 H25 V29 H9 V25 H5 V9 H8 Z"/>
            <GeometryDrawing Brush="#7E8588" Geometry="M10,9 H24 V12 H27 V24 H23 V27 H10 V24 H7 V12 H10 Z"/>
            <GeometryDrawing Brush="#E3493F" Geometry="M17,8 L23,17 L17,15 Z"/>
            <GeometryDrawing Brush="#F1F1E9" Geometry="M17,26 L11,17 L17,19 Z"/>
            <GeometryDrawing Brush="#22282B" Geometry="M15,15 H19 V19 H15 Z"/>
        </DrawingGroup></DrawingImage.Drawing>
    </DrawingImage>
    <DrawingImage x:Key="PixelIconCreate">
        <DrawingImage.Drawing><DrawingGroup>
            <!-- Crafting table with a clear plus symbol -->
            <GeometryDrawing Brush="#5A321B" Geometry="M1,1 H33 V33 H1 Z"/>
            <GeometryDrawing Brush="#B56B31" Geometry="M4,4 H30 V30 H4 Z"/>
            <GeometryDrawing Brush="#E0A05A" Geometry="M6,6 H14 V14 H6 Z M20,6 H28 V14 H20 Z M6,20 H14 V28 H6 Z M20,20 H28 V28 H20 Z"/>
            <GeometryDrawing Brush="#69401F" Geometry="M14,4 H20 V30 H14 Z M4,14 H30 V20 H4 Z"/>
            <GeometryDrawing Brush="#FFFFFF" Geometry="M15,7 H19 V27 H15 Z M7,15 H27 V19 H7 Z"/>
            <GeometryDrawing Brush="#3FAE3A" Geometry="M16,8 H18 V26 H16 Z M8,16 H26 V18 H8 Z"/>
        </DrawingGroup></DrawingImage.Drawing>
    </DrawingImage>
    <DrawingImage x:Key="PixelIconConsole">
        <DrawingImage.Drawing><DrawingGroup>
            <!-- Pixel terminal window -->
            <GeometryDrawing Brush="#252A2E" Geometry="M1,3 H33 V31 H1 Z"/>
            <GeometryDrawing Brush="#4B555D" Geometry="M3,5 H31 V29 H3 Z"/>
            <GeometryDrawing Brush="#121619" Geometry="M5,10 H29 V27 H5 Z"/>
            <GeometryDrawing Brush="#E7ECEF" Geometry="M7,13 H10 V15 H12 V17 H10 V19 H7 V17 H9 V15 H7 Z M14,20 H23 V22 H14 Z"/>
            <GeometryDrawing Brush="#55D66B" Geometry="M6,6 H9 V9 H6 Z"/>
            <GeometryDrawing Brush="#F0B429" Geometry="M11,6 H14 V9 H11 Z"/>
            <GeometryDrawing Brush="#E34A43" Geometry="M16,6 H19 V9 H16 Z"/>
        </DrawingGroup></DrawingImage.Drawing>
    </DrawingImage>
    <DrawingImage x:Key="PixelIconConfiguration">
        <DrawingImage.Drawing><DrawingGroup>
            <!-- Three unmistakable settings sliders, rendered as Minecraft pixels -->
            <GeometryDrawing Brush="#263238" Geometry="M2,3 H32 V31 H2 Z"/>
            <GeometryDrawing Brush="#42545C" Geometry="M4,5 H30 V29 H4 Z"/>
            <GeometryDrawing Brush="#D9E1E4" Geometry="M7,9 H27 V12 H7 Z M7,16 H27 V19 H7 Z M7,23 H27 V26 H7 Z"/>
            <GeometryDrawing Brush="#E34A43" Geometry="M11,7 H16 V14 H11 Z"/>
            <GeometryDrawing Brush="#55D66B" Geometry="M20,14 H25 V21 H20 Z"/>
            <GeometryDrawing Brush="#F0B429" Geometry="M14,21 H19 V28 H14 Z"/>
        </DrawingGroup></DrawingImage.Drawing>
    </DrawingImage>
    <DrawingImage x:Key="PixelIconAbout">
        <DrawingImage.Drawing><DrawingGroup>
            <!-- Minecraft book with information symbol -->
            <GeometryDrawing Brush="#5B321E" Geometry="M2,4 H16 V30 H2 Z M18,4 H32 V30 H18 Z"/>
            <GeometryDrawing Brush="#F3E4B2" Geometry="M5,6 H15 V27 H5 Z M19,6 H29 V27 H19 Z"/>
            <GeometryDrawing Brush="#C7B47D" Geometry="M15,5 H19 V29 H15 Z"/>
            <GeometryDrawing Brush="#2B78C5" Geometry="M21,8 H27 V13 H21 Z M22,15 H26 V24 H22 Z"/>
            <GeometryDrawing Brush="#8B6A3E" Geometry="M7,10 H13 V12 H7 Z M7,15 H13 V17 H7 Z M7,20 H13 V22 H7 Z"/>
        </DrawingGroup></DrawingImage.Drawing>
    </DrawingImage>
    <DrawingImage x:Key="PixelIconBackups">
        <DrawingImage.Drawing><DrawingGroup>
            <!-- Minecraft chest with a clock face -->
            <GeometryDrawing Brush="#4B2B18" Geometry="M1,7 H33 V31 H1 Z"/>
            <GeometryDrawing Brush="#C8792D" Geometry="M3,9 H31 V29 H3 Z"/>
            <GeometryDrawing Brush="#E59A3D" Geometry="M3,9 H31 V17 H3 Z"/>
            <GeometryDrawing Brush="#6B3E20" Geometry="M3,17 H31 V20 H3 Z"/>
            <GeometryDrawing Brush="#EAF3F6" Geometry="M18,14 H31 V27 H18 Z"/>
            <GeometryDrawing Brush="#263238" Geometry="M20,16 H29 V25 H20 Z"/>
            <GeometryDrawing Brush="#FFFFFF" Geometry="M22,18 H27 V23 H22 Z"/>
            <GeometryDrawing Brush="#55D66B" Geometry="M24,18 H25 V21 H27 V22 H24 Z"/>
        </DrawingGroup></DrawingImage.Drawing>
    </DrawingImage>

    <DrawingImage x:Key="PixelIconPlugins">
        <DrawingImage.Drawing><DrawingGroup>
            <!-- Minecraft redstone repeater: plugin/module management -->
            <GeometryDrawing Brush="#8B8B86" Geometry="M2,5 H32 V29 H2 Z"/>
            <GeometryDrawing Brush="#C9C8BE" Geometry="M4,7 H30 V27 H4 Z"/>
            <GeometryDrawing Brush="#6A6258" Geometry="M5,24 H29 V27 H5 Z"/>
            <GeometryDrawing Brush="#A52A26" Geometry="M7,14 H13 V20 H7 Z M21,14 H27 V20 H21 Z"/>
            <GeometryDrawing Brush="#F05B4F" Geometry="M9,12 H11 V15 H9 Z M23,12 H25 V15 H23 Z"/>
            <GeometryDrawing Brush="#D8D4C7" Geometry="M15,10 H19 V24 H15 Z"/>
            <GeometryDrawing Brush="#D33B32" Geometry="M16,8 H18 V14 H16 Z M14,18 H20 V21 H14 Z"/>
        </DrawingGroup></DrawingImage.Drawing>
    </DrawingImage>
    <DrawingImage x:Key="PixelIconWorlds">
        <DrawingImage.Drawing><DrawingGroup>
            <!-- Minecraft grass block: world management -->
            <GeometryDrawing Brush="#4A2C18" Geometry="M2,4 H32 V30 H2 Z"/>
            <GeometryDrawing Brush="#8B5A2B" Geometry="M4,12 H30 V28 H4 Z"/>
            <GeometryDrawing Brush="#6E431F" Geometry="M6,18 H12 V24 H6 Z M20,14 H27 V20 H20 Z M14,24 H20 V28 H14 Z"/>
            <GeometryDrawing Brush="#5EA93D" Geometry="M4,6 H30 V14 H4 Z"/>
            <GeometryDrawing Brush="#7BCB52" Geometry="M6,4 H28 V10 H6 Z"/>
            <GeometryDrawing Brush="#3E842E" Geometry="M4,11 H9 V16 H4 Z M13,10 H18 V14 H13 Z M24,10 H30 V16 H24 Z"/>
        </DrawingGroup></DrawingImage.Drawing>
    </DrawingImage>
    <DrawingImage x:Key="PixelIconManagement">
        <DrawingImage.Drawing><DrawingGroup>
            <!-- Minecraft command block: server administration -->
            <GeometryDrawing Brush="#4D2D1C" Geometry="M2,2 H32 V32 H2 Z"/>
            <GeometryDrawing Brush="#C8743B" Geometry="M4,4 H30 V30 H4 Z"/>
            <GeometryDrawing Brush="#E29A58" Geometry="M7,7 H27 V27 H7 Z"/>
            <GeometryDrawing Brush="#6D3B25" Geometry="M9,9 H25 V25 H9 Z"/>
            <GeometryDrawing Brush="#D9894D" Geometry="M11,11 H23 V23 H11 Z"/>
            <GeometryDrawing Brush="#F1C08C" Geometry="M13,15 H17 V13 H19 V15 H21 V19 H19 V21 H15 V19 H13 Z"/>
            <GeometryDrawing Brush="#70432E" Geometry="M5,5 H8 V8 H5 Z M26,5 H29 V8 H26 Z M5,26 H8 V29 H5 Z M26,26 H29 V29 H26 Z"/>
        </DrawingGroup></DrawingImage.Drawing>
    </DrawingImage>

    <DrawingImage x:Key="PixelIconFolder">
        <DrawingImage.Drawing><DrawingGroup>
            <!-- Minecraft chest as the semantic equivalent of a server folder -->
            <GeometryDrawing Brush="#4B2B18" Geometry="M1,7 H33 V31 H1 Z"/>
            <GeometryDrawing Brush="#C8792D" Geometry="M3,9 H31 V29 H3 Z"/>
            <GeometryDrawing Brush="#E59A3D" Geometry="M3,9 H31 V17 H3 Z"/>
            <GeometryDrawing Brush="#6B3E20" Geometry="M3,17 H31 V20 H3 Z M15,9 H19 V29 H15 Z"/>
            <GeometryDrawing Brush="#E6D16A" Geometry="M14,15 H20 V23 H14 Z"/>
            <GeometryDrawing Brush="#FFF0A0" Geometry="M16,17 H18 V21 H16 Z"/>
        </DrawingGroup></DrawingImage.Drawing>
    </DrawingImage>

    <LinearGradientBrush x:Key="GreenButton" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#68C63F" Offset="0"/>
        <GradientStop Color="#3F9E2F" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="CardBackground" Color="#FFFFFF"/>

    <!-- Typography -->
    <Style TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
    </Style>
    <Style TargetType="Label">
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="0,5"/>
    </Style>
    <Style x:Key="SectionHeader" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Margin" Value="0,0,0,12"/>
    </Style>
    <Style x:Key="MetricLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Margin" Value="0,0,0,5"/>
    </Style>
    <Style x:Key="FieldCaption" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
    </Style>
    <Style x:Key="FieldIcon" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="Foreground" Value="{StaticResource Green}"/>
        <Setter Property="Margin" Value="0,0,8,0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="IconText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
        <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="NavIconTile" TargetType="Border">
        <Setter Property="Width" Value="36"/>
        <Setter Property="Height" Value="36"/>
        <Setter Property="CornerRadius" Value="18"/>
        <Setter Property="Background" Value="#263238"/>
        <Setter Property="BorderBrush" Value="#172126"/>
        <Setter Property="BorderThickness" Value="2"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Margin" Value="0,0,10,0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="QuickIconTile" TargetType="Border">
        <Setter Property="Width" Value="40"/>
        <Setter Property="Height" Value="40"/>
        <Setter Property="CornerRadius" Value="20"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
    </Style>

    <!-- Surfaces -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource CardBackground}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="14"/>
        <Setter Property="Padding" Value="20"/>
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect Color="#7C8790" BlurRadius="10" ShadowDepth="1" Opacity="0.10"/>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Buttons -->
    <Style TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        <Setter Property="Background" Value="{StaticResource Surface}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderStrong}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="17,10"/>
        <Setter Property="Margin" Value="4"/>
        <Setter Property="MinHeight" Value="42"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#F3F6F1"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="#AEB8AE"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#E9EFE6"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Green}"/>
                            <Setter TargetName="Bd" Property="BorderThickness" Value="2"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="LightButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="#FFFFFF"/>
        <Setter Property="BorderBrush" Value="#B7C0C7"/>
    </Style>

    <Style x:Key="SolidActionButtonBase" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Effect">
            <Setter.Value><DropShadowEffect Color="#53606A" BlurRadius="7" ShadowDepth="1" Opacity="0.20"/></Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}" TextElement.Foreground="{TemplateBinding Foreground}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter Property="Opacity" Value="1"/><Setter TargetName="Bd" Property="BorderThickness" Value="2"/></Trigger>
                        <Trigger Property="IsPressed" Value="True"><Setter Property="Opacity" Value="0.82"/></Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Bd" Property="BorderBrush" Value="#FFFFFF"/><Setter TargetName="Bd" Property="BorderThickness" Value="2"/></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.38"/><Setter Property="Cursor" Value="Arrow"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="GreenActionButton" TargetType="Button" BasedOn="{StaticResource SolidActionButtonBase}">
        <Setter Property="Background" Value="{StaticResource GreenButton}"/>
        <Setter Property="BorderBrush" Value="#358B28"/>
        <Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{StaticResource ActionGreenHover}"/><Setter Property="BorderBrush" Value="#E7FFE1"/></Trigger></Style.Triggers>
    </Style>
    <Style x:Key="BlueActionButton" TargetType="Button" BasedOn="{StaticResource SolidActionButtonBase}">
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Background" Value="{StaticResource ActionBlue}"/>
        <Setter Property="BorderBrush" Value="{StaticResource ActionBlueDark}"/>
        <Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="White"/><Setter Property="Background" Value="{StaticResource ActionBlueHover}"/><Setter Property="BorderBrush" Value="#D9F0FF"/></Trigger></Style.Triggers>
    </Style>
    <Style x:Key="AmberActionButton" TargetType="Button" BasedOn="{StaticResource SolidActionButtonBase}">
        <Setter Property="Foreground" Value="#171717"/>
        <Setter Property="Background" Value="{StaticResource ActionAmber}"/>
        <Setter Property="BorderBrush" Value="{StaticResource ActionAmberDark}"/>
        <Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{StaticResource ActionAmberHover}"/><Setter Property="BorderBrush" Value="#5E4300"/></Trigger></Style.Triggers>
    </Style>
    <Style x:Key="DangerActionButton" TargetType="Button" BasedOn="{StaticResource SolidActionButtonBase}">
        <Setter Property="Background" Value="{StaticResource ActionRed}"/>
        <Setter Property="BorderBrush" Value="{StaticResource ActionRedDark}"/>
        <Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{StaticResource ActionRedHover}"/><Setter Property="BorderBrush" Value="#FFE2E0"/></Trigger></Style.Triggers>
    </Style>
    <Style x:Key="NavigationButton" TargetType="Button">
        <Setter Property="Height" Value="48"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Padding" Value="10,0"/>
        <Setter Property="Margin" Value="0,0,0,5"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        <Setter Property="Background" Value="#FFFFFF"/>
        <Setter Property="BorderBrush" Value="#CBD4DA"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="NavBorder"
                            Background="{TemplateBinding Background}"
                            TextElement.Foreground="{TemplateBinding Foreground}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="11"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="NavBorder" Property="Background" Value="{StaticResource NavigationHover}"/>
                            <Setter TargetName="NavBorder" Property="BorderBrush" Value="{StaticResource NavigationHoverBorder}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="NavBorder" Property="Background" Value="#DDEFD7"/>
                        </Trigger>
                        <Trigger Property="Tag" Value="Selected">
                            <Setter TargetName="NavBorder" Property="Background" Value="{StaticResource NavigationSelected}"/>
                            <Setter TargetName="NavBorder" Property="BorderBrush" Value="#8FE36F"/>
                            <Setter TargetName="NavBorder" Property="BorderThickness" Value="5,1,1,1"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="Tag" Value="Selected"/>
                                <Condition Property="IsMouseOver" Value="True"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="NavBorder" Property="Background" Value="{StaticResource NavigationSelectedHover}"/>
                            <Setter TargetName="NavBorder" Property="BorderBrush" Value="#B6F2AA"/>
                            <Setter TargetName="NavBorder" Property="BorderThickness" Value="5,2,2,2"/>
                        </MultiTrigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="NavBorder" Property="BorderBrush" Value="#76C963"/>
                            <Setter TargetName="NavBorder" Property="BorderThickness" Value="2"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="NavBorder" Property="Opacity" Value="0.42"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="QuickToolButton" TargetType="Button">
        <Setter Property="Height" Value="82"/><Setter Property="Margin" Value="5"/><Setter Property="Padding" Value="8"/>
        <Setter Property="BorderThickness" Value="1"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
            <Border x:Name="QuickBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10" Padding="{TemplateBinding Padding}" TextElement.Foreground="{TemplateBinding Foreground}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="QuickBorder" Property="BorderThickness" Value="3"/></Trigger>
                <Trigger Property="IsPressed" Value="True"><Setter Property="Opacity" Value="0.78"/></Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="QuickBorder" Property="BorderBrush" Value="White"/><Setter TargetName="QuickBorder" Property="BorderThickness" Value="3"/></Trigger>
                <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.38"/></Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="BlueQuickToolButton" TargetType="Button" BasedOn="{StaticResource QuickToolButton}">
        <Setter Property="Background" Value="{StaticResource ActionBlue}"/><Setter Property="BorderBrush" Value="{StaticResource ActionBlueDark}"/><Setter Property="Foreground" Value="White"/>
        <Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{StaticResource ActionBlueHover}"/><Setter Property="BorderBrush" Value="#EAF7FF"/><Setter Property="Foreground" Value="White"/></Trigger></Style.Triggers>
    </Style>
    <Style x:Key="AmberQuickToolButton" TargetType="Button" BasedOn="{StaticResource QuickToolButton}">
        <Setter Property="Background" Value="{StaticResource ActionAmber}"/><Setter Property="BorderBrush" Value="{StaticResource ActionAmberDark}"/><Setter Property="Foreground" Value="#171717"/>
        <Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{StaticResource ActionAmberHover}"/><Setter Property="BorderBrush" Value="#5E4300"/></Trigger></Style.Triggers>
    </Style>
    <Style x:Key="PurpleQuickToolButton" TargetType="Button" BasedOn="{StaticResource QuickToolButton}">
        <Setter Property="Background" Value="{StaticResource ActionPurple}"/><Setter Property="BorderBrush" Value="{StaticResource ActionPurpleDark}"/><Setter Property="Foreground" Value="White"/>
        <Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{StaticResource ActionPurpleHover}"/><Setter Property="BorderBrush" Value="#F0E7FF"/></Trigger></Style.Triggers>
    </Style>

    <!-- Semantic aliases for future pages -->
    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource BlueActionButton}"/>
    <Style x:Key="SuccessButton" TargetType="Button" BasedOn="{StaticResource GreenActionButton}"/>
    <Style x:Key="InfoButton" TargetType="Button" BasedOn="{StaticResource BlueActionButton}"/>
    <Style x:Key="WarningButton" TargetType="Button" BasedOn="{StaticResource AmberActionButton}"/>
    <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource DangerActionButton}"/>
    <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource LightButton}"/>

    <!-- Status badge foundations -->
    <Style x:Key="StatusBadge" TargetType="Border">
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Padding" Value="10,4"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
    </Style>

    <!-- Inputs -->
    <Style TargetType="TextBox">
        <Setter Property="MinHeight" Value="42"/>
        <Setter Property="Background" Value="{StaticResource InputBackground}"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderStrong}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="11,8"/>
        <Setter Property="CaretBrush" Value="{StaticResource DarkGreen}"/>
        <Setter Property="SelectionBrush" Value="#BCE8A8"/>
        <Style.Triggers>
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource Green}"/>
                <Setter Property="BorderThickness" Value="2"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.55"/></Trigger>
        </Style.Triggers>
    </Style>
    <Style TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        <Setter Property="Background" Value="White"/>
        <Setter Property="Padding" Value="12,9"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Style.Triggers>
            <Trigger Property="IsHighlighted" Value="True"><Setter Property="Background" Value="#EAF5E6"/></Trigger>
            <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#DCEFD5"/><Setter Property="FontWeight" Value="SemiBold"/></Trigger>
        </Style.Triggers>
    </Style>
    <Style TargetType="ComboBox">
        <Setter Property="Background" Value="White"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderStrong}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="MinHeight" Value="42"/>
        <Setter Property="Padding" Value="12,8"/>
        <Setter Property="Margin" Value="0,4,0,0"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style TargetType="ProgressBar">
        <Setter Property="Height" Value="7"/>
        <Setter Property="Foreground" Value="{StaticResource Green}"/>
        <Setter Property="Background" Value="#E6E9EB"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Grid><Border Background="{TemplateBinding Background}" CornerRadius="4"/><Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" HorizontalAlignment="Left" CornerRadius="4"/></Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
