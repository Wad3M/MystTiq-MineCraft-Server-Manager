<UserControl x:Class="ASimpleMinecraftServer.UI.Pages.PluginManagerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <TabControl>
        <TabItem Header="Installed Plugins">
<Border Style="{StaticResource Card}" Padding="18" AllowDrop="True" DragOver="PluginArea_DragOver" Drop="PluginArea_Drop">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="PLUGIN MANAGER" Style="{StaticResource SectionHeader}"/>
                <TextBlock x:Name="PluginServerTextControl" x:FieldModifier="public" Text="Select a Paper or Purpur server to manage plugins." Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap"/>
            </StackPanel>
            <Button Grid.Column="1" Style="{StaticResource BlueActionButton}" Content="Install Plugin JAR" Width="155" Click="InstallPlugin_Click"/>
        </Grid>
        <Border Grid.Row="1" Height="1" Background="#E6E9EB" Margin="0,14,0,14"/>
        <Grid Grid.Row="2" Margin="0,0,0,12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBox x:Name="PluginSearchBoxControl" x:FieldModifier="public" ToolTip="Search plugin name, file, author, dependency, or version" TextChanged="PluginSearchBox_TextChanged" Padding="10,7"/>
            <TextBlock Grid.Column="1" Text="Drag .jar files anywhere onto this page to install" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" Margin="14,0"/>
            <Button Grid.Column="2" Style="{StaticResource SecondaryButton}" Content="Clear Search" Width="105" Click="ClearPluginSearch_Click"/>
        </Grid>
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions><ColumnDefinition Width="2.3*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <DataGrid x:Name="PluginsGridControl" x:FieldModifier="public" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" SelectionMode="Extended" HeadersVisibility="Column" SelectionChanged="PluginsGrid_SelectionChanged">
                <DataGrid.Columns>
                    <DataGridCheckBoxColumn Header="Enabled" Binding="{Binding IsEnabled}" Width="75"/>
                    <DataGridTextColumn Header="Plugin" Binding="{Binding Name}" Width="1.3*"/>
                    <DataGridTextColumn Header="Installed" Binding="{Binding Version}" Width="*"/>
                    <DataGridTextColumn Header="Latest" Binding="{Binding LatestVersion}" Width="*"/>
                    <DataGridTextColumn Header="Update" Binding="{Binding UpdateStatus}" Width="1.25*"/>
                    <DataGridTextColumn Header="API" Binding="{Binding ApiVersion}" Width="*"/>
                    <DataGridTextColumn Header="Health" Binding="{Binding HealthText}" Width="1.2*"/>
                    <DataGridTextColumn Header="File" Binding="{Binding FileName}" Width="1.5*"/>
                </DataGrid.Columns>
            </DataGrid>
            <StackPanel Grid.Column="2">
                <Border Background="#F7F9FA" BorderBrush="#D9DEE2" BorderThickness="1" CornerRadius="10" Padding="14">
                    <StackPanel>
                        <TextBlock Text="PLUGIN DETAILS" Style="{StaticResource SectionHeader}"/>
                        <TextBlock Text="NAME" Style="{StaticResource FieldCaption}"/><TextBlock x:Name="PluginDetailNameTextControl" x:FieldModifier="public" Text="—" FontWeight="Bold" Margin="0,2,0,10" TextWrapping="Wrap"/>
                        <TextBlock Text="MAIN CLASS" Style="{StaticResource FieldCaption}"/><TextBlock x:Name="PluginDetailMainTextControl" x:FieldModifier="public" Text="—" Margin="0,2,0,10" TextWrapping="Wrap"/>
                        <TextBlock Text="AUTHORS" Style="{StaticResource FieldCaption}"/><TextBlock x:Name="PluginDetailAuthorsTextControl" x:FieldModifier="public" Text="—" Margin="0,2,0,10" TextWrapping="Wrap"/>
                        <TextBlock Text="DEPENDENCIES" Style="{StaticResource FieldCaption}"/><TextBlock x:Name="PluginDetailDependenciesTextControl" x:FieldModifier="public" Text="—" Margin="0,2,0,10" TextWrapping="Wrap"/>
                        <TextBlock Text="SOFT DEPENDENCIES" Style="{StaticResource FieldCaption}"/><TextBlock x:Name="PluginDetailSoftDependenciesTextControl" x:FieldModifier="public" Text="—" Margin="0,2,0,10" TextWrapping="Wrap"/>
                        <TextBlock Text="COMPATIBILITY" Style="{StaticResource FieldCaption}"/><TextBlock x:Name="PluginDetailCompatibilityTextControl" x:FieldModifier="public" Text="—" Margin="0,2,0,10" TextWrapping="Wrap"/>
                        <TextBlock Text="LAST MODIFIED" Style="{StaticResource FieldCaption}"/><TextBlock x:Name="PluginDetailModifiedTextControl" x:FieldModifier="public" Text="—" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>
                <TextBlock Text="Select multiple plugins with Ctrl or Shift for batch actions. Changes take effect after the next server start." Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" Margin="2,12,2,0"/>
            </StackPanel>
        </Grid>
        <Grid Grid.Row="4" Margin="0,16,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock x:Name="PluginStatusTextControl" x:FieldModifier="public" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,12,0"/>
            <Button Grid.Column="1" Style="{StaticResource BlueActionButton}" Content="Check Updates" Width="112" Click="CheckPluginUpdates_Click"/>
            <Button Grid.Column="2" Style="{StaticResource SuccessButton}" Content="Update Selected" Width="120" Margin="8,0,0,0" Click="UpdateSelectedPlugins_Click"/>
            <Button Grid.Column="3" Style="{StaticResource SuccessButton}" Content="Update All" Width="95" Margin="8,0,0,0" Click="UpdateAllPlugins_Click"/>
            <Button Grid.Column="4" Style="{StaticResource SecondaryButton}" Content="Open Folder" Width="100" Margin="8,0,0,0" Click="OpenPluginFolder_Click"/>
            <Button Grid.Column="5" Style="{StaticResource SecondaryButton}" Content="Refresh" Width="80" Margin="8,0,0,0" Click="RefreshPlugins_Click"/>
            <Button Grid.Column="6" Style="{StaticResource SuccessButton}" Content="Enable" Width="80" Margin="8,0,0,0" Click="EnablePlugin_Click"/>
            <Button Grid.Column="7" Style="{StaticResource WarningButton}" Content="Disable" Width="80" Margin="8,0,0,0" Click="DisablePlugin_Click"/>
            <Button Grid.Column="8" Style="{StaticResource DangerButton}" Content="Delete" Width="80" Margin="8,0,0,0" Click="DeletePlugin_Click"/>
        </Grid>
    </Grid>
</Border>
        </TabItem>
        <TabItem Header="Browse Plugins">
            <Border Style="{StaticResource Card}" Padding="18">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Text="PLUGIN BROWSER" Style="{StaticResource SectionHeader}"/>
                        <TextBlock x:Name="CatalogServerTextControl" x:FieldModifier="public" Text="Select a Paper, Purpur, or Folia server to browse compatible plugins." Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap"/>
                    </StackPanel>
                    <Grid Grid.Row="1" Margin="0,16,0,12">
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBox x:Name="CatalogSearchBoxControl" x:FieldModifier="public" ToolTip="Search Modrinth plugins" Padding="10,7" KeyDown="CatalogSearchBox_KeyDown"/>
                        <Button Grid.Column="1" Style="{StaticResource BlueActionButton}" Content="Search" Width="95" Margin="8,0,0,0" Click="SearchCatalog_Click"/>
                        <Button Grid.Column="2" Style="{StaticResource SuccessButton}" Content="Install Selected" Width="130" Margin="8,0,0,0" Click="InstallCatalogPlugin_Click"/>
                    </Grid>
                    <DataGrid Grid.Row="2" x:Name="CatalogGridControl" x:FieldModifier="public" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" SelectionMode="Single" HeadersVisibility="Column">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Plugin" Binding="{Binding Name}" Width="1.2*"/>
                            <DataGridTextColumn Header="Author" Binding="{Binding Author}" Width="*"/>
                            <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="2.4*"/>
                            <DataGridTextColumn Header="Downloads" Binding="{Binding DownloadsText}" Width="95"/>
                            <DataGridTextColumn Header="Latest" Binding="{Binding LatestVersion}" Width="90"/>
                            <DataGridTextColumn Header="Compatibility" Binding="{Binding CompatibilityText}" Width="1.4*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <Grid Grid.Row="3" Margin="0,14,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock x:Name="CatalogStatusTextControl" x:FieldModifier="public" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                        <TextBlock Grid.Column="1" Text="Powered by Modrinth" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                    </Grid>
                </Grid>
            </Border>
        </TabItem>
    </TabControl>
</UserControl>